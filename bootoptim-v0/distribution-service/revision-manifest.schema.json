{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bootoptim.invalid/schemas/distribution/revision-manifest-v1.json",
  "title": "BootOptim private modpack revision manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "profile",
    "game",
    "base",
    "permissions",
    "mods",
    "remove_mods",
    "configs",
    "remove_configs",
    "objects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "game": {
      "$ref": "#/$defs/game"
    },
    "base": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/base" }
      ]
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "mods": {
      "type": "array",
      "items": { "$ref": "#/$defs/mod_entry" },
      "default": []
    },
    "remove_mods": {
      "type": "array",
      "items": { "$ref": "#/$defs/remove_mod" },
      "default": []
    },
    "configs": {
      "type": "array",
      "items": { "$ref": "#/$defs/config_entry" },
      "default": []
    },
    "remove_configs": {
      "type": "array",
      "items": { "$ref": "#/$defs/remove_config" },
      "default": []
    },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/object_entry" },
      "default": []
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "base": { "type": "null" } },
        "required": ["base"]
      },
      "then": {
        "properties": {
          "remove_mods": { "maxItems": 0 },
          "remove_configs": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^profile_[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[A-Za-z0-9_-]{16,80}$"
    },
    "safe_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "created_at"],
      "properties": {
        "id": { "$ref": "#/$defs/revision_id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "release_notes": { "type": "string", "maxLength": 8192 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "official"],
      "properties": {
        "id": { "$ref": "#/$defs/profile_id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "official": { "const": true }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minecraft", "neoforge"],
      "properties": {
        "minecraft": { "type": "string", "minLength": 1, "maxLength": 64 },
        "neoforge": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "revision_id", "manifest_sha256"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/profile_id" },
        "revision_id": { "$ref": "#/$defs/revision_id" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derive_local", "mods", "configs", "max_inheritance_depth"],
      "properties": {
        "derive_local": { "type": "boolean" },
        "mods": {
          "type": "object",
          "additionalProperties": false,
          "required": ["add", "remove"],
          "properties": {
            "add": { "type": "boolean" },
            "remove": { "type": "boolean" }
          }
        },
        "configs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["override_enforced", "override_default_once"],
          "properties": {
            "override_enforced": { "type": "boolean" },
            "override_default_once": { "type": "boolean" }
          }
        },
        "max_inheritance_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    },
    "object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "mod_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "object"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mod_[A-Za-z0-9._-]{1,120}$"
        },
        "path": { "$ref": "#/$defs/safe_path" },
        "object": { "$ref": "#/$defs/object_ref" },
        "expect_base_object_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        }
      }
    },
    "remove_mod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expect_base_object_sha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mod_[A-Za-z0-9._-]{1,120}$"
        },
        "expect_base_object_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "config_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "object", "policy"],
      "properties": {
        "path": { "$ref": "#/$defs/safe_path" },
        "object": { "$ref": "#/$defs/object_ref" },
        "policy": {
          "type": "string",
          "enum": ["enforced", "default_once"]
        },
        "expect_base_object_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        }
      }
    },
    "remove_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expect_base_object_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safe_path" },
        "expect_base_object_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "object_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "object"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^obj_[A-Za-z0-9._-]{1,120}$"
        },
        "path": { "$ref": "#/$defs/safe_path" },
        "object": { "$ref": "#/$defs/object_ref" },
        "expect_base_object_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        }
      }
    }
  }
}
