{
  "schema": "wbombo-jvm-option-vectors/1",
  "description": "Shared allowlist vectors for profile JVM options. Distribution, Pandora and the Android launcher must all accept and reject exactly these rendered arguments. Copy this file verbatim when updating a client.",
  "allowed_system_properties": [],
  "accept": [
    { "arg": "-XX:CICompilerCount=2", "flag_key": "XX:CICompilerCount" },
    { "arg": "-XX:+UseG1GC", "flag_key": "XX:UseG1GC" },
    { "arg": "-XX:-UseAdaptiveSizePolicy", "flag_key": "XX:UseAdaptiveSizePolicy" },
    { "arg": "-XX:+UnlockExperimentalVMOptions", "flag_key": "XX:UnlockExperimentalVMOptions" },
    { "arg": "-XX:MaxGCPauseMillis=50", "flag_key": "XX:MaxGCPauseMillis" },
    { "arg": "-XX:ReservedCodeCacheSize=256m", "flag_key": "XX:ReservedCodeCacheSize" },
    { "arg": "-XX:MaxRAMPercentage=50.0", "flag_key": "XX:MaxRAMPercentage" },
    { "arg": "-Xss4m", "flag_key": "Xss" },
    { "arg": "-Xms2G", "flag_key": "Xms" },
    { "arg": "-Xmx6144m", "flag_key": "Xmx" },
    { "arg": "-Xmx8g", "flag_key": "Xmx" }
  ],
  "reject": [
    { "arg": "", "why": "empty" },
    { "arg": "-javaagent:evil.jar", "why": "agent" },
    { "arg": "-agentpath:/tmp/x.so", "why": "native agent" },
    { "arg": "-agentlib:jdwp=transport=dt_socket", "why": "native agent" },
    { "arg": "-cp", "why": "classpath" },
    { "arg": "-classpath", "why": "classpath" },
    { "arg": "--class-path", "why": "classpath" },
    { "arg": "--add-opens=java.base/java.lang=ALL-UNNAMED", "why": "module escape" },
    { "arg": "--add-exports=java.base/sun.nio.ch=ALL-UNNAMED", "why": "module escape" },
    { "arg": "--patch-module=java.base=x.jar", "why": "module patch" },
    { "arg": "--module-path=x", "why": "module path" },
    { "arg": "@args.txt", "why": "argument file" },
    { "arg": "-jar", "why": "not allowlisted" },
    { "arg": "-Xbootclasspath/a:x.jar", "why": "boot classpath" },
    { "arg": "-Xlog:gc*:file=gc.log", "why": "not allowlisted" },
    { "arg": "-verbose:class", "why": "not allowlisted" },
    { "arg": "-Dfoo=bar", "why": "system property not in allowlist" },
    { "arg": "-Djava.class.path=x", "why": "system property not in allowlist" },
    { "arg": "-XX:OnOutOfMemoryError=calc.exe", "why": "text value" },
    { "arg": "-XX:OnError=cmd", "why": "text value" },
    { "arg": "-XX:ErrorFile=/tmp/x", "why": "text value" },
    { "arg": "-XX:HeapDumpPath=/tmp", "why": "text value" },
    { "arg": "-XX:Flags=.hotspotrc", "why": "denied flag" },
    { "arg": "-XX:VMOptionsFile=x", "why": "denied flag" },
    { "arg": "-XX:+IgnoreUnrecognizedVMOptions", "why": "hides unknown options" },
    { "arg": "-XX:+EnableJVMCI", "why": "alternative compiler" },
    { "arg": "-XX:+UseJVMCICompiler", "why": "alternative compiler" },
    { "arg": "-XX:+LogVMOutput", "why": "writes log file" },
    { "arg": "-XX:+ShowMessageBoxOnError", "why": "can hang the VM" },
    { "arg": "-XX:+ManagementServer", "why": "management access" },
    { "arg": "-XX:+Name=3", "why": "malformed" },
    { "arg": "-XX:CICompilerCount=", "why": "missing value" },
    { "arg": "-XX:CICompilerCount=-1", "why": "negative value" },
    { "arg": "-XX:CICompilerCount=2 -javaagent:x.jar", "why": "space" },
    { "arg": "-XX:9Bad=1", "why": "malformed name" },
    { "arg": "-Xmx", "why": "missing size" },
    { "arg": "-Xmx6GB", "why": "bad size" },
    { "arg": "-Xss4m\n", "why": "control character" }
  ]
}
