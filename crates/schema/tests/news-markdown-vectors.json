{
 "schema_version": 1,
 "description": "Shared test vectors for the restricted Markdown of Distribution news (docs/PROFILE_PROTOCOL.md, Cuerpo de la noticia). Every client must accept exactly the accepted cases and reject the rejected ones; for accepted cases the normalized blocks, image and video counts must match (see the notes field). Cases avoid backslash escapes, entities and hard breaks.",
 "notes": {
  "cas_existing": "cas:\u003csha256\u003e images are valid only if the digest is listed here (the server asks its CAS; clients treat every cas: image of an accepted news as present).",
  "blocks": "Normalized description. paragraph/heading text is plain: emphasis and link markup removed, images contribute their alt text, soft and hard line breaks are \"\n\". list items hold blocks (tight list text counts as a paragraph). image is a paragraph whose only content is one image. an absent blocks field means no blocks. youtube is a paragraph whose only content is a YouTube link (bare URL, link or autolink); id is the 11-character video id.",
  "image_hints": "An image may carry presentation hints in its CommonMark title (double or single quotes): size=small|medium|large|full and align=left|center, separated by whitespace, e.g. ![alt](cas:<sha256> \"size=medium align=center\"). The image block exposes size and align (absent = empty string = not given; clients default to medium and left). The last token of each key wins; an unknown value or key is ignored, so that key stays empty; a title without those fields is not an error. src is only the URL or cas: reference. Width caps in logical pixels: small 180, medium 300, large 480, full = the whole container; align=center centers an image narrower than the container.",
  "images": "Number of images (image blocks plus images inside text). YouTube videos are not images.",
  "videos": "Number of youtube blocks.",
  "error_line": "1-based line of the first problem for rejected cases. The server reports it in the message of 422 invalid_news_body; clients only need to reject (the line is informative).",
  "tables": "A table (a text line followed by a |---| separator line) is rejected even though plain CommonMark would render it as text. A line with pipes and no separator is plain text.",
  "limits": {
   "max_body_bytes": 65536,
   "max_images": 50,
   "max_videos": 10,
   "max_url_bytes": 2048,
   "max_list_levels": 2
  }
 },
 "cas_existing": [
  "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
 ],
