+    private LinearLayout panel(){LinearLayout v=column();v.setPadding(dp(12),dp(12),dp(12),dp(12));v.setBackground(background(PANEL));return v;}
+    private LinearLayout column(){LinearLayout v=new LinearLayout(activity);v.setOrientation(VERTICAL);return v;}
+    private LinearLayout row(){LinearLayout v=new LinearLayout(activity);v.setOrientation(HORIZONTAL);v.setGravity(Gravity.CENTER_VERTICAL);return v;}
+    private TextView text(String value,int size,int color){TextView v=new TextView(activity);v.setText(value);v.setTextSize(size);v.setTextColor(color);v.setGravity(Gravity.CENTER_VERTICAL);return v;}
+    private TextView button(String value,int accent,Runnable click){TextView v=text(value,14,accent);v.setGravity(Gravity.CENTER);v.setMinHeight(dp(44));v.setPadding(dp(14),0,dp(14),0);v.setBackground(background(accent==GREEN?Color.rgb(20,49,34):accent==CYAN?Color.rgb(14,39,44):PANEL));v.setOnClickListener(w->click.run());v.setFocusable(true);return v;}
+    private GradientDrawable background(int color){GradientDrawable d=new GradientDrawable();d.setColor(color);d.setCornerRadius(dp(8));d.setStroke(dp(1),BORDER);return d;}
+    private int dp(int value){return Math.round(value*getResources().getDisplayMetrics().density);}
+}
