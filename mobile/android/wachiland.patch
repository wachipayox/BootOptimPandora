--- /dev/null
+++ b/FCL/src/main/java/net/wachiland/launcher/ThermalDiagnostics.kt
@@ -0,0 +1,180 @@
+package net.wachiland.launcher
+
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.BatteryManager
+import android.os.Build
+import android.os.PowerManager
+import android.os.Process
+import android.os.SystemClock
+import android.view.WindowManager
+import org.json.JSONObject
+import java.io.File
+import java.util.concurrent.Executors
+import java.util.concurrent.ScheduledExecutorService
+import java.util.concurrent.TimeUnit
+
+/** Android policy and cheap, independent thermal telemetry; never controls game threads or GL. */
+object ThermalDiagnostics {
+    private const val PREFS = "wachiland_process_diagnostics"
+    @Volatile private var executor: ScheduledExecutorService? = null
+    private var listener: PowerManager.OnThermalStatusChangedListener? = null
+    private var power: PowerManager? = null
+    @Volatile private var requested = false
+    @Volatile private var supported = false
+    @Volatile private var applied = false
+    @Volatile private var windowError: String? = null
+    @Volatile private var displayHz = 0f
+    @Volatile private var surfaceVoteHz = 0f
+    @Volatile private var gameOptions = JSONObject()
+
+    @JvmStatic fun modeEnabled(context: Context) = context.getSharedPreferences(PREFS, 0)
+        .getBoolean("thermal_mode", true)
+    fun setModeEnabled(context: Context, enabled: Boolean) {
+        context.getSharedPreferences(PREFS, 0).edit().putBoolean("thermal_mode", enabled).apply()
+    }
+    @JvmStatic fun sustainedSupported(context: Context) = runCatching {
+        (context.getSystemService(Context.POWER_SERVICE) as PowerManager).isSustainedPerformanceModeSupported
+    }.getOrDefault(false)
+
+    /** Called on the game Activity's UI thread, before its surface starts the JVM. */
+    @JvmStatic fun configureWindow(activity: Activity) {
+        requested = modeEnabled(activity)
+        supported = sustainedSupported(activity)
+        applied = false
+        windowError = null
+        surfaceVoteHz = 0f
+        gameOptions = JSONObject()
+        runCatching {
+            activity.window.setSustainedPerformanceMode(requested && supported)
+            applied = requested && supported // API request accepted, not proof of frequency/heat reduction.
+        }.onFailure { windowError = it.javaClass.simpleName }
+        recordDisplay(activity)
+    }
+    @JvmStatic fun thermalModeForWindow() = requested
+    @JvmStatic fun recordSurfaceVote(rate: Float) { surfaceVoteHz = rate }
+    @JvmStatic fun recordDisplay(activity: Activity) {
+        runCatching {
+            @Suppress("DEPRECATION")
+            displayHz = activity.windowManager.defaultDisplay.refreshRate
+        }
+    }
+    @JvmStatic fun releaseWindow(activity: Activity) {
+        runCatching { activity.window.setSustainedPerformanceMode(false) }
+        applied = false
+    }
+    @JvmStatic fun recordOptions(gameDir: String?) {
+        if (gameDir == null) { gameOptions = JSONObject(); return }
+        gameOptions = runCatching {
+            val file = File(gameDir, "options.txt")
+            val result = JSONObject()
+            if (file.isFile && file.length() <= 1024 * 1024) file.useLines { lines ->
+                lines.forEach { line ->
+                    val key = line.substringBefore(':')
+                    if (key in setOf("maxFps", "enableVsync", "renderDistance", "simulationDistance"))
+                        result.put(key, line.substringAfter(':').take(80))
+                }
+            }
+            result
+        }.getOrDefault(JSONObject()) // Read-only allowlist; never records credentials or edits options.
+    }
+
+    @Synchronized fun begin(context: Context, prefix: String) {
+        stop()
+        val app = context.applicationContext
+        val file = File(app.filesDir, "exit-diagnostics/$prefix-thermal.jsonl")
+        val service = Executors.newSingleThreadScheduledExecutor { task ->
+            Thread({
+                runCatching { Process.setThreadPriority(Process.THREAD_PRIORITY_BACKGROUND) }
+                task.run()
+            }, "Wachiland-thermal").apply { isDaemon = true }
+        }
+        executor = service
+        val manager = app.getSystemService(Context.POWER_SERVICE) as? PowerManager
+        power = manager
+        var previousWall = SystemClock.elapsedRealtime()
+        var previousCpu = Process.getElapsedCpuTime()
+        val origin = previousWall
+        if (Build.VERSION.SDK_INT >= 29 && manager != null) runCatching {
+            val callback = PowerManager.OnThermalStatusChangedListener { status ->
+                append(file, JSONObject().put("event", "thermal_status_changed")
+                    .put("epoch_ms", System.currentTimeMillis()).put("elapsed_ms", SystemClock.elapsedRealtime())
+                    .put("thermal_status", status).put("thermal_status_name", statusName(status)))
+            }
+            listener = callback
+            manager.addThermalStatusListener(service, callback)
+        }.onFailure {
+            append(file, JSONObject().put("event", "thermal_listener_unavailable")
+                .put("epoch_ms", System.currentTimeMillis()).put("error", it.javaClass.simpleName))
+        }
+        service.scheduleWithFixedDelay({
+            runCatching {
+                val tick = SystemClock.elapsedRealtime()
+                runCatching {
+                    @Suppress("DEPRECATION")
+                    displayHz = (app.getSystemService(Context.WINDOW_SERVICE) as WindowManager).defaultDisplay.refreshRate
+                }
+                val cpu = Process.getElapsedCpuTime()
+                val wallDelta = tick - previousWall
+                val cpuDelta = (cpu - previousCpu).coerceAtLeast(0)
+                previousWall = tick; previousCpu = cpu
+                val row = JSONObject().put("event", "sample").put("epoch_ms", System.currentTimeMillis())
+                    .put("elapsed_ms", tick).put("session_elapsed_ms", tick - origin).put("pid", Process.myPid())
+                    .put("reported_cpu_count", Runtime.getRuntime().availableProcessors())
+                    .put("cpu_interval_ms", wallDelta).put("process_cpu_delta_ms", cpuDelta)
+                    .put("thermal_mode_requested", requested).put("sustained_supported", supported)
+                    .put("sustained_window_request_accepted", applied).put("display_refresh_hz", displayHz)
+                    .put("surface_refresh_vote_hz", surfaceVoteHz).put("options_at_launch", gameOptions)
+                if (wallDelta >= 1000) row.put("process_cpu_core_equivalents", cpuDelta.toDouble() / wallDelta)
+                windowError?.let { row.put("window_policy_error", it) }
+                if (manager != null) {
+                    row.put("power_save_mode", manager.isPowerSaveMode)
+                    if (Build.VERSION.SDK_INT >= 29) runCatching {
+                        val status = manager.currentThermalStatus
+                        row.put("thermal_status", status).put("thermal_status_name", statusName(status))
+                    }.onFailure { row.put("thermal_status_error", it.javaClass.simpleName) }
+                    if (Build.VERSION.SDK_INT >= 30) runCatching {
+                        val headroom = manager.getThermalHeadroom(0)
+                        row.put("thermal_headroom_available", headroom.isFinite())
+                        if (headroom.isFinite()) row.put("thermal_headroom", headroom.toDouble())
+                    }.onFailure { row.put("thermal_headroom_error", it.javaClass.simpleName) }
+                }
+                runCatching {
+                    app.registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED))?.let { battery ->
+                        for (key in listOf(BatteryManager.EXTRA_TEMPERATURE, BatteryManager.EXTRA_PLUGGED,
+                            BatteryManager.EXTRA_STATUS, BatteryManager.EXTRA_LEVEL, BatteryManager.EXTRA_SCALE,
+                            BatteryManager.EXTRA_HEALTH, BatteryManager.EXTRA_VOLTAGE))
+                            if (battery.hasExtra(key)) row.put("battery_$key", battery.getIntExtra(key, -1))
+                        if (battery.hasExtra(BatteryManager.EXTRA_TEMPERATURE))
+                            row.put("battery_temperature_c", battery.getIntExtra(BatteryManager.EXTRA_TEMPERATURE, 0) / 10.0)
+                    }
+                }.onFailure { row.put("battery_error", it.javaClass.simpleName) }
+                row.put("sample_duration_ms", SystemClock.elapsedRealtime() - tick)
+                append(file, row)
+            }.onFailure {
+                append(file, JSONObject().put("event", "sample_error").put("epoch_ms", System.currentTimeMillis())
+                    .put("error", it.javaClass.simpleName))
+            }
+        }, 0, 10, TimeUnit.SECONDS) // Thermal headroom must never be polled faster than every 10s.
+        service.schedule({ stopIfCurrent(service) }, 3, TimeUnit.HOURS)
+    }
+    @Synchronized private fun stopIfCurrent(service: ScheduledExecutorService) {
+        if (executor === service) stop()
+    }
+    @Synchronized fun stop() {
+        if (Build.VERSION.SDK_INT >= 29) listener?.let { callback ->
+            runCatching { power?.removeThermalStatusListener(callback) }
+        }
+        listener = null; power = null
+        executor?.shutdownNow(); executor = null
+    }
+    private fun append(file: File, row: JSONObject) {
+        runCatching { if (file.length() < 1024 * 1024) file.appendText(row.toString() + "\n") }
+    }
+    private fun statusName(status: Int) = when (status) {
+        0 -> "NONE"; 1 -> "LIGHT"; 2 -> "MODERATE"; 3 -> "SEVERE"; 4 -> "CRITICAL"
+        5 -> "EMERGENCY"; 6 -> "SHUTDOWN"; else -> "UNKNOWN_$status"
+    }
+}
