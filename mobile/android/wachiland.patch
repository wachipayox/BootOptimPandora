index 0000000..3548242
--- /dev/null
+++ b/FCL/memory-probe/src/main/java/net/wachiland/diagnostics/HeapAttribution.java
@@ -0,0 +1,171 @@
+package net.wachiland.diagnostics;
+
+import java.io.File;
+import java.io.FileWriter;
+import java.lang.management.ManagementFactory;
+import java.lang.reflect.InvocationTargetException;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+import java.util.HashMap;
+import java.util.Map;
+import javax.management.ObjectName;
+
+/** Explicit one-session diagnostic, not a production optimization or a heap dump. */
+final class HeapAttribution {
+    private final File csv;
+    private final File status;
+    private Object recording;
+    private Class<?> recordingClass;
+    private boolean menuHandled;
+
+    private HeapAttribution(File csv) {
+        this.csv = csv;
+        status = file("heap-status.txt");
+    }
+
+    static void start(final File csv) {
+        if (!Boolean.getBoolean("wachiland.memory.deep")) return;
+        final HeapAttribution probe = new HeapAttribution(csv);
+        Thread worker = new Thread(new Runnable() {
+            @Override public void run() { probe.run(); }
+        }, "Wachiland-Java-object-attribution");
+        worker.setDaemon(true);
+        worker.setPriority(Thread.MIN_PRIORITY);
+        worker.start();
+    }
+
+    private void run() {
+        note("Diagnostic only. Allocation samples/old-object samples are not a complete retained-owner graph. " +
+                "Histograms count shallow bytes, not per-mod retained size. Live census requests one full GC; " +
+                "this changes timing/occupancy and may pause the game. No cache removal, heap dump or root traversal.");
+        try {
+            startRecording();
+            long deadline = System.nanoTime() + 20L * 60 * 1000000000L;
+            int tick = 0;
+            while (System.nanoTime() < deadline) {
+                Thread.sleep(5000);
+                if (++tick % 6 == 0) snapshot();
+                File request = file("menu.request");
+                if (!menuHandled && request.isFile()) {
+                    menuHandled = true; // No retry after a partial/high-impact operation.
+                    note("Menu request received: " + new String(Files.readAllBytes(request.toPath()), "UTF-8"));
+                    if (hasHeadroom()) {
+                        histogram("occupied", new String[] { "-all", "-parallel=1" });
+                        if (hasHeadroom()) histogram("live", new String[] { "-parallel=1" });
+                        else note("Live census skipped: fresh headroom guard failed after occupied census.");
+                    } else note("Menu census skipped: no fresh Android headroom guard (requires >=768 MiB available).");
+                    snapshot();
+                }
+            }
+            snapshot();
+            note("20-minute diagnostic window ended.");
+        } catch (InterruptedException ignored) {
+            Thread.currentThread().interrupt();
+        } catch (Throwable e) {
+            note("Optional attribution stopped: " + cause(e));
+        } finally {
+            if (recording != null) try { recordingClass.getMethod("close").invoke(recording); }
+            catch (Throwable ignored) { }
+        }
+    }
+
+    private void startRecording() {
+        long start = System.nanoTime();
+        try {
+            recordingClass = Class.forName("jdk.jfr.Recording");
+            Map<String, String> settings = new HashMap<String, String>();
+            settings.put("jdk.ObjectAllocationSample#enabled", "true");
+            settings.put("jdk.ObjectAllocationSample#stackTrace", "true");
+            settings.put("jdk.ObjectAllocationSample#throttle", "20/s");
+            settings.put("jdk.OldObjectSample#enabled", "true");
+            settings.put("jdk.OldObjectSample#stackTrace", "true");
+            settings.put("jdk.OldObjectSample#cutoff", "0 ns"); // No expensive path-to-root traversal.
+            settings.put("jdk.GarbageCollection#enabled", "true");
+            settings.put("jdk.GCHeapSummary#enabled", "true");
+            settings.put("jdk.G1HeapSummary#enabled", "true");
+            recording = recordingClass.getConstructor(Map.class).newInstance(settings);
+            recordingClass.getMethod("setName", String.class).invoke(recording, "Wachiland Java object attribution");
+            recordingClass.getMethod("setToDisk", boolean.class).invoke(recording, true);
+            recordingClass.getMethod("setMaxSize", long.class).invoke(recording, 16L * 1024 * 1024);
+            recordingClass.getMethod("start").invoke(recording);
+            note("JFR active: allocation target 20/s, old-object stacks, cutoff=0 (no roots), " +
+                    "repository rolling target 16 MiB. Snapshot every 30 s. Initialization_ms=" + elapsed(start));
+        } catch (Throwable e) {
+            note("JFR unavailable: " + cause(e) + "; census remains independently available.");
+            if (recording != null) try { recordingClass.getMethod("close").invoke(recording); }
+            catch (Throwable ignored) { }
+            recording = null;
+        }
+    }
+
+    private void snapshot() {
+        if (recording == null) return;
+        File staged = file("allocation.jfr.tmp");
+        long start = System.nanoTime();
+        try {
+            recordingClass.getMethod("dump", java.nio.file.Path.class).invoke(recording, staged.toPath());
+            // JFR's repository limit is chunk based, not a hard byte limit on a snapshot.
+            if (staged.length() > 32L * 1024 * 1024) {
+                note("Snapshot exceeds 32 MiB; retaining previous complete snapshot and stopping JFR.");
+                recordingClass.getMethod("close").invoke(recording);
+                recording = null;
+                return;
+            }
+            publish(staged, file("allocation.jfr"));
+            note("JFR snapshot complete; duration_ms=" + elapsed(start) + "; bytes=" + file("allocation.jfr").length());
+        } catch (Throwable e) { note("JFR snapshot unavailable: " + cause(e)); }
+        finally { staged.delete(); }
+    }
+
+    private boolean hasHeadroom() {
+        try {
+            String[] guard = new String(Files.readAllBytes(file("headroom.guard").toPath()), "UTF-8").trim().split(",");
+            long age = System.currentTimeMillis() - Long.parseLong(guard[0]);
+            return age >= 0 && age <= 15000 && Long.parseLong(guard[1]) >= 768L * 1024 * 1024 && "false".equals(guard[2]);
+        } catch (Throwable ignored) { return false; }
+    }
+
+    private void histogram(String kind, String[] options) {
+        long start = System.nanoTime();
+        Runtime runtime = Runtime.getRuntime();
+        long before = runtime.totalMemory() - runtime.freeMemory();
+        File staged = file("histogram-" + kind + ".txt.tmp");
+        note("Histogram " + kind + " beginning; heap_used_before_bytes=" + before);
+        try {
+            Object result = ManagementFactory.getPlatformMBeanServer().invoke(
+                    new ObjectName("com.sun.management:type=DiagnosticCommand"), "gcClassHistogram",
+                    new Object[] { options }, new String[] { "[Ljava.lang.String;" });
+            String text = String.valueOf(result);
+            if (text.length() > 2 * 1024 * 1024) throw new IllegalStateException("Histogram text exceeds 2 MiB");
+            long after = runtime.totalMemory() - runtime.freeMemory();
+            try (FileWriter out = new FileWriter(staged)) {
+                out.write("epoch_ms=" + System.currentTimeMillis() + "; kind=" + kind + "; duration_ms=" + elapsed(start) +
+                        "; heap_before_bytes=" + before + "; heap_after_bytes=" + after + "\n");
+                out.write(kind.equals("live") ? "One requested full GC, then live-class census. Diagnostic changes workload.\n" :
+                        "Includes unreachable objects (-all); not retained/live bytes.\n");
+                out.write("Bytes are shallow object sizes; arrays cannot be assigned to an owner from this table alone.\n");
+                out.write(text);
+            }
+            publish(staged, file("histogram-" + kind + ".txt"));
+            note("Histogram " + kind + " complete; duration_ms=" + elapsed(start) + "; heap_after_bytes=" + after);
+        } catch (Throwable e) { note("Histogram " + kind + " unavailable: " + cause(e)); }
+        finally { staged.delete(); }
+    }
+
+    private File file(String suffix) { return new File(csv.getParentFile(), csv.getName().replace("jvm.csv", suffix)); }
+    private static long elapsed(long start) { return (System.nanoTime() - start) / 1000000; }
+    private static String cause(Throwable e) {
+        if (e instanceof InvocationTargetException && e.getCause() != null) e = e.getCause();
+        return e.getClass().getName() + ": " + String.valueOf(e.getMessage());
+    }
+    private void note(String message) {
+        try {
+            if (status.length() > 128 * 1024) return;
+            try (FileWriter out = new FileWriter(status, true)) { out.write(System.currentTimeMillis() + " " + message + "\n"); }
+        } catch (Throwable ignored) { }
+    }
+    private static void publish(File staged, File target) throws Exception {
+        try { Files.move(staged.toPath(), target.toPath(), StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING); }
+        catch (java.nio.file.AtomicMoveNotSupportedException e) { Files.move(staged.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING); }
+    }
+}
diff --git a/FCL/memory-probe/src/main/java/net/wachiland/diagnostics/MemoryMain.java b/FCL/memory-probe/src/main/java/net/wachiland/diagnostics/MemoryMain.java
new file mode 100644
index 0000000..6e9a339
--- /dev/null
+++ b/FCL/memory-probe/src/main/java/net/wachiland/diagnostics/MemoryMain.java
@@ -0,0 +1,96 @@
+package net.wachiland.diagnostics;
+
+import java.io.File;
+import java.io.FileWriter;
+import java.lang.management.BufferPoolMXBean;
+import java.lang.management.GarbageCollectorMXBean;
+import java.lang.management.ManagementFactory;
+import java.lang.management.MemoryUsage;
+import java.lang.management.MemoryPoolMXBean;
+import java.lang.reflect.InvocationTargetException;
+
+/** Runs in embedded OpenJDK, never in Android ART. No transforms; basic sampling never forces GC. Deep attribution is opt-in. */
+public final class MemoryMain {
+    private static final String HEADER = "epoch_ms,session_elapsed_ms,heap_used_bytes,heap_committed_bytes,heap_max_bytes,nonheap_used_bytes,nonheap_committed_bytes,direct_used_bytes,mapped_used_bytes,gc_count,gc_time_ms,threads,sample_duration_ms,g1_old_used_bytes,g1_young_used_bytes\n";
+
+    public static void main(String[] args) throws Throwable {
+        try { start(); } catch (Throwable e) {
+            System.err.println("[Wachiland memory] Optional probe unavailable: " + e.getClass().getName());
+        }
+        // Keep the upstream wrapper and its launch/error handling intact.
+        try {
+            Class.forName("mio.Wrapper").getMethod("main", String[].class).invoke(null, (Object) args);
+        } catch (InvocationTargetException e) { throw e.getCause(); }
+    }
+
+    private static void start() throws Exception {
+        final File csv = new File(System.getProperty("wachiland.memory.file"));
+        final long origin = Long.parseLong(System.getProperty("wachiland.memory.origin"));
+        write(csv, HEADER, false);
+        write(new File(csv.getParentFile(), csv.getName().replace("jvm.csv", "jvm-info.txt")),
+                "Runtime: embedded OpenJDK, not Android ART\njava.version=" + System.getProperty("java.version") +
+                "\njava.vm.name=" + System.getProperty("java.vm.name") + "\norigin_epoch_ms=" + origin +
+                "\nSchema: 2. Units: bytes except times/counts. Heap committed is not resident memory.\n" +
+                "G1 old/young are logical pool occupancy, not a live-object census or additional memory to add.\n" +
+                "Direct buffers do not include all LWJGL/mod/driver allocations. Missing metrics = -1.\n", false);
+        Thread sampler = new Thread(new Runnable() {
+            @Override public void run() {
+                // Bounded to three hours; retain flushed partial data on SIGKILL.
+                for (int i = 0; i < 1080; i++) {
+                    try { sample(csv, origin); }
+                    catch (Throwable e) {
+                        try { write(new File(csv.getParentFile(), csv.getName().replace("jvm.csv", "jvm-errors.txt")),
+                                System.currentTimeMillis() + " " + e.getClass().getName() + "\n", true); }
+                        catch (Throwable ignored) { }
+                        return;
+                    }
+                    try { Thread.sleep(10000); } catch (InterruptedException e) { return; }
+                }
+            }
+        }, "Wachiland-game-memory");
+        sampler.setDaemon(true);
+        sampler.setPriority(Thread.MIN_PRIORITY);
+        sampler.start();
+        HeapAttribution.start(csv);
+        System.out.println("[Wachiland memory] Embedded JVM recording enabled, 10 s interval; no heap/settings changes.");
+    }
+
+    private static void sample(File csv, long origin) throws Exception {
+        long tick = System.nanoTime();
+        long epoch = System.currentTimeMillis();
+        Runtime runtime = Runtime.getRuntime();
+        long committed = runtime.totalMemory(), used = committed - runtime.freeMemory();
+        long nonheap = -1, nonheapCommitted = -1, direct = -1, mapped = -1, gc = -1, gcTime = -1, threads = -1;
+        long oldUsed = -1, youngUsed = -1;
+        // Some mobile runtimes omit java.management; Runtime heap sampling still works.
+        try {
+            MemoryUsage usage = ManagementFactory.getMemoryMXBean().getNonHeapMemoryUsage();
+            nonheap = usage.getUsed(); nonheapCommitted = usage.getCommitted();
+            for (BufferPoolMXBean pool : ManagementFactory.getPlatformMXBeans(BufferPoolMXBean.class)) {
+                if (pool.getName().equals("direct")) direct = pool.getMemoryUsed();
+                if (pool.getName().equals("mapped")) mapped = pool.getMemoryUsed();
+            }
+            gc = 0; gcTime = 0;
+            for (GarbageCollectorMXBean collector : ManagementFactory.getGarbageCollectorMXBeans()) {
+                if (collector.getCollectionCount() >= 0) gc += collector.getCollectionCount();
+                if (collector.getCollectionTime() >= 0) gcTime += collector.getCollectionTime();
+            }
+            threads = ManagementFactory.getThreadMXBean().getThreadCount();
+            for (MemoryPoolMXBean pool : ManagementFactory.getMemoryPoolMXBeans()) {
+                MemoryUsage poolUsage = pool.getUsage();
+                if (poolUsage == null) continue;
+                if (pool.getName().equals("G1 Old Gen")) oldUsed = poolUsage.getUsed();
+                if (pool.getName().equals("G1 Eden Space") || pool.getName().equals("G1 Survivor Space"))
+                    youngUsed = (youngUsed < 0 ? 0 : youngUsed) + poolUsage.getUsed();
+            }
+        } catch (Throwable ignored) { }
+        if (csv.length() > 4 * 1024 * 1024) return;
+        write(csv, epoch + "," + (epoch - origin) + "," + used + "," + committed + "," + runtime.maxMemory() +
+                "," + nonheap + "," + nonheapCommitted + "," + direct + "," + mapped + "," + gc + "," + gcTime +
+                "," + threads + "," + ((System.nanoTime() - tick) / 1000000) + "," + oldUsed + "," + youngUsed + "\n", true);
+    }
+
+    private static void write(File file, String text, boolean append) throws Exception {
+        try (FileWriter out = new FileWriter(file, append)) { out.write(text); }
+    }
+}
