+
+/** Landscape, touch-sized Wachiland home. Native FCL pages provide runtime/settings tools. */
+public final class WachilandDashboard extends LinearLayout {
+    private static final ExecutorService IO=Executors.newFixedThreadPool(3);
+    private static final int BG=Color.rgb(10,10,10), PANEL=Color.rgb(16,16,16), BORDER=Color.rgb(42,42,42);
+    private static final int WHITE=Color.rgb(244,244,244), MUTED=Color.rgb(155,163,172);
+    private static final int GREEN=Color.rgb(62,215,133), CYAN=Color.rgb(28,210,230);
+    private final MainActivity activity;
+    private final LinearLayout globalCards, instances;
+    private final TextView account, status;
+    private boolean working=false, attached=false, loaded=false;
+    private final Consumer<Profile> versionsListener=p->post(this::renderInstances);
