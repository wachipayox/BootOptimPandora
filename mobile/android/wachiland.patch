+package net.wachiland.performance;
+
+import java.io.File;
+import java.io.FileWriter;
+import java.io.PrintWriter;
+import java.io.StringWriter;
+import java.lang.instrument.ClassFileTransformer;
+import java.lang.instrument.Instrumentation;
+import java.lang.management.ManagementFactory;
+import java.lang.management.ThreadInfo;
+import java.lang.management.ThreadMXBean;
+import java.lang.reflect.Field;
+import java.security.ProtectionDomain;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.jar.JarFile;
+import jdk.internal.org.objectweb.asm.ClassReader;
+import jdk.internal.org.objectweb.asm.ClassVisitor;
+import jdk.internal.org.objectweb.asm.ClassWriter;
+import jdk.internal.org.objectweb.asm.Label;
+import jdk.internal.org.objectweb.asm.MethodVisitor;
+import jdk.internal.org.objectweb.asm.Opcodes;
+import jdk.internal.org.objectweb.asm.Type;
+import jdk.internal.org.objectweb.asm.commons.AdviceAdapter;
+import jdk.internal.org.objectweb.asm.commons.Method;
+import jdk.internal.org.objectweb.asm.util.CheckClassAdapter;
+
+/** Optional, bounded diagnostic agent; never changes game/GL arguments or results. */
+public final class PerformanceAgent {
+    private static File base;
+    private static Instrumentation agent;
+    private static Field kerriaConfig;
+    private static final Set<String> TARGETS = Set.of("net/minecraft/client/Minecraft", "net/minecraft/client/renderer/texture/TextureManager", "com/mojang/blaze3d/platform/NativeImage", "org/lwjgl/opengl/GL11C", "org/lwjgl/glfw/GLFW", "net/minecraft/client/renderer/GameRenderer", "net/minecraft/client/multiplayer/ClientLevel", "net/createmod/catnip/placement/PlacementClient", "neoforge/fun/qu_an/minecraft/asyncparticles/client/particle/AsyncTickBehavior", "fun/qu_an/minecraft/asyncparticles/client/particle/AsyncTickBehavior", "org/lwjgl/opengl/GL32C");
+
+    public static void premain(String ignored, Instrumentation instrumentation) {
+        try {
+            base = new File(System.getProperty("wachiland.performance.base"));
+            agent = instrumentation;
+            instrumentation.appendToBootstrapClassLoaderSearch(new JarFile(System.getProperty("wachiland.performance.bootstrap")));
+            // Resolve counters after append, so every transformed loader shares bootstrap counters.
+            Class.forName("net.wachiland.performance.PerformanceCounters", true, null);
+            write("status.txt", "epoch_ms=" + System.currentTimeMillis() + "\nagent_ready=true\nJava 17+ diagnostic. Wall-call durations include waits, scheduling and native work; not GPU execution time. Inclusive metrics overlap. Histograms have bucket upper bounds, not exact quantiles.\n", false);
+            instrumentation.addTransformer(new ClassFileTransformer() {
+                @Override public byte[] transform(Module module, ClassLoader loader, String name, Class<?> redefining, ProtectionDomain domain, byte[] bytes) {
+                    if (!TARGETS.contains(name)) return null;
+                    try {
+                        if (module != null && module.isNamed()) instrumentation.redefineModule(module, Set.of(PerformanceCounters.class.getModule()), Collections.emptyMap(), Collections.emptyMap(), Collections.emptySet(), Collections.emptyMap());
+                        ClassReader reader = new ClassReader(bytes);
+                        // Resolve actual loader types; abort instrumentation rather than guess frames.
+                        ClassWriter writer = new ClassWriter(reader, ClassWriter.COMPUTE_FRAMES | ClassWriter.COMPUTE_MAXS) {
+                            @Override protected String getCommonSuperClass(String a, String b) {
+                                try {
+                                    Class<?> ca = Class.forName(a.replace('/', '.'), false, loader), cb = Class.forName(b.replace('/', '.'), false, loader);
+                                    if (ca.isAssignableFrom(cb)) return a;
+                                    if (cb.isAssignableFrom(ca)) return b;
+                                    if (ca.isInterface() || cb.isInterface()) return "java/lang/Object";
+                                    do { ca = ca.getSuperclass(); } while (!ca.isAssignableFrom(cb));
+                                    return ca.getName().replace('.', '/');
+                                } catch (Throwable error) { throw new IllegalStateException("Unresolved frame hierarchy", error); }
+                            }
+                        };
+                        int[] hooked = {0};
+                        reader.accept(new ClassVisitor(Opcodes.ASM8, writer) {
+                            @Override public MethodVisitor visitMethod(int access, String method, String descriptor, String signature, String[] exceptions) {
+                                MethodVisitor visitor = super.visitMethod(access, method, descriptor, signature, exceptions);
+                                int metric = metric(name, method, descriptor);
+                                if (metric < 0 || (access & (Opcodes.ACC_NATIVE | Opcodes.ACC_ABSTRACT)) != 0) return visitor;
+                                hooked[0]++;
+                                return new AdviceAdapter(Opcodes.ASM8, visitor, access, method, descriptor) {
+                                    final Type counter = Type.getObjectType("net/wachiland/performance/PerformanceCounters");
+                                    final Label start = new Label(), end = new Label(), handler = new Label();
+                                    int stamp;
+                                    void finish() { push(metric); loadLocal(stamp); invokeStatic(counter, new Method("exit", "(IJ)V")); }
+                                    @Override protected void onMethodEnter() {
+                                        push(metric); invokeStatic(counter, new Method("enter", "(I)J"));
+                                        stamp = newLocal(Type.LONG_TYPE); storeLocal(stamp);
+                                        if (metric == 4 && descriptor.equals("(IIIIIIIIJ)V")) { loadArg(4); loadArg(5); invokeStatic(counter, new Method("pixels", "(II)V")); }
+                                        mark(start);
+                                    }
+                                    @Override protected void onMethodExit(int opcode) { if (opcode != ATHROW) finish(); }
+                                    @Override public void visitMaxs(int stack, int locals) {
+                                        mark(end); visitTryCatchBlock(start, end, handler, "java/lang/Throwable"); mark(handler);
+                                        int error = newLocal(Type.getType(Throwable.class)); storeLocal(error); finish(); loadLocal(error); throwException();
+                                        super.visitMaxs(stack, locals);
+                                    }
+                                };
+                            }
+                        }, ClassReader.EXPAND_FRAMES);
+                        if (hooked[0] == 0) return null;
+                        byte[] transformed = writer.toByteArray();
+                        StringWriter errors = new StringWriter();
+                        CheckClassAdapter.verify(new ClassReader(transformed), loader, false, new PrintWriter(errors));
+                        if (!errors.toString().isBlank()) {
+                            note("transform_skipped_verification " + name);
+                            return null;
+                        }
+                        write("hooks.txt", name + " verified_methods=" + hooked[0] + "\n", true);
+                        return transformed;
+                    } catch (Throwable error) {
+                        note("transform_skipped " + name + " " + error.getClass().getSimpleName());
+                        return null;
+                    }
+                }
+            }, false);
+            Thread worker = new Thread(PerformanceAgent::capture, "Wachiland-performance");
+            worker.setDaemon(true); worker.setPriority(Thread.MIN_PRIORITY); worker.start();
+            System.out.println("[Wachiland performance] Ready; one automatic 120 s capture after world/JEI readiness.");
+        } catch (Throwable error) { note("agent_unavailable " + error.getClass().getSimpleName()); }
+    }
+
+    private static int metric(String owner, String name, String desc) {
+        if (owner.endsWith("/Minecraft")) return name.equals("runTick") && desc.equals("(Z)V") ? 0 : name.equals("tick") && desc.equals("()V") ? 1 : -1;
+        if (owner.endsWith("/TextureManager") && name.equals("tick") && desc.equals("()V")) return 2;
+        if (owner.endsWith("/NativeImage") && name.equals("_upload")) return 3;
+        if (owner.endsWith("/GL11C") && name.equals("glTexSubImage2D")) return 4;
+        if (owner.endsWith("/GLFW") && name.equals("glfwSwapBuffers")) return 5;
+        if (owner.endsWith("/GameRenderer") && name.equals("renderLevel")) return 6;
+        if (owner.endsWith("/ClientLevel") && name.equals("animateTick")) return 7;
+        if (owner.endsWith("/PlacementClient") && name.equals("checkHelpers")) return 8;
+        if (owner.endsWith("/AsyncTickBehavior") && name.equals("postTick")) return 9;
+        if (owner.endsWith("/GL32C") && name.equals("glMultiDrawElementsBaseVertex")) return 10;
+        return -1;
+    }
+
+    private static void capture() {
+        try {
+            File request = new File(base + "-request.txt");
+            long deadline = System.currentTimeMillis() + 3 * 60 * 60 * 1000;
+            String reason = null;
+            while (System.currentTimeMillis() < deadline) {
+                if (request.isFile()) { reason = "launcher_world_and_jei_marker"; break; }
+                if (PerformanceCounters.firstWorld > 0 && System.currentTimeMillis() - PerformanceCounters.firstWorld >= 90000) { reason = "90s_after_first_world_render_fallback"; break; }
+                Thread.sleep(2000);
+            }
+            if (reason == null) { note("capture_not_started_no_world_marker"); return; }
+            // Give JEI completion and the loading overlay 20 seconds to settle.
+            Thread.sleep(20000);
+            long origin = System.currentTimeMillis();
+            write("calls.csv", "epoch_ms,elapsed_ms,metric,calls_total,wall_ns_total,pixels_total,histogram_total\n", false);
+            write("threads.csv", "epoch_ms,thread_id,name,state,cpu_ns_total,stack\n", false);
+            note("capture_start epoch_ms=" + origin + " reason=" + reason + " duration_s=120");
+            for (Class<?> type : agent.getAllLoadedClasses()) if (type.getName().equals("me.decce.kerria.Kerria")) {
+                try {
+                    Module mod = type.getModule();
+                    if (mod.isNamed()) agent.redefineModule(mod, Collections.emptySet(), Collections.emptyMap(), Collections.singletonMap(type.getPackageName(), Set.of(PerformanceAgent.class.getModule())), Collections.emptySet(), Collections.emptyMap());
+                    kerriaConfig = type.getDeclaredField("config"); kerriaConfig.setAccessible(true);
+                } catch (Throwable error) { note("kerria_effective_config_unavailable " + error.getClass().getSimpleName()); }
+            }
+            write("effective-settings.csv", "epoch_ms,kerria_loaded,kerria_enabled,cache,fastUpload,fastLightTextureUpload\n", false);
+            PerformanceCounters.active = true;
+            ThreadMXBean bean = ManagementFactory.getThreadMXBean();
+            try { if (bean.isThreadCpuTimeSupported() && !bean.isThreadCpuTimeEnabled()) bean.setThreadCpuTimeEnabled(true); }
+            catch (Throwable error) { note("thread_cpu_unavailable " + error.getClass().getSimpleName()); }
+            long end = System.nanoTime() + 120000000000L;
+            long nextRows = 0;
+            long[] ids = new long[0];
+            while (System.nanoTime() < end) {
+                long tick = System.nanoTime(), epoch = System.currentTimeMillis();
+                if (epoch >= nextRows) {
+                    rows(epoch, origin);
+                    effectiveSettings(epoch);
+                    Set<Long> selected = new HashSet<>();
+                    for (ThreadInfo info : bean.getThreadInfo(bean.getAllThreadIds(), 0)) if (info != null && (info.getThreadName().equals("Render thread") || info.getThreadName().equals("Server thread"))) selected.add(info.getThreadId());
+                    ids = selected.stream().mapToLong(Long::longValue).toArray();
+                    nextRows = epoch + 1000;
+                }
+                // Two selected stacks every 500 ms, never walk all mod-worker stacks.
+                StringBuilder stacks = new StringBuilder();
+                for (ThreadInfo info : bean.getThreadInfo(ids, 20)) if (info != null) {
+                    long cpu = -1;
+                    try { if (bean.isThreadCpuTimeSupported() && bean.isThreadCpuTimeEnabled()) cpu = bean.getThreadCpuTime(info.getThreadId()); } catch (Throwable ignored) { }
+                    stacks.append(epoch).append(',').append(info.getThreadId()).append(',').append(info.getThreadName()).append(',').append(info.getThreadState()).append(',').append(cpu).append(',');
+                    for (StackTraceElement frame : info.getStackTrace()) stacks.append(frame.getClassName()).append('.').append(frame.getMethodName()).append(':').append(frame.getLineNumber()).append('|');
+                    stacks.append('\n');
+                }
+                write("threads.csv", stacks.toString(), true);
+                write("sampler.csv", epoch + "," + (System.nanoTime() - tick) + "\n", true);
+                Thread.sleep(500);
+            }
+            PerformanceCounters.active = false;
+            rows(System.currentTimeMillis(), origin);
+            note("capture_complete epoch_ms=" + System.currentTimeMillis());
+        } catch (Throwable error) { note("capture_error " + error.getClass().getSimpleName()); }
+        finally { PerformanceCounters.active = false; }
+    }
+
+    private static void effectiveSettings(long epoch) {
+        try {
+            Object config = kerriaConfig == null ? null : kerriaConfig.get(null);
+            StringBuilder out = new StringBuilder().append(epoch).append(',').append(kerriaConfig != null);
+            for (String key : new String[] {"enabled", "cache", "fastUpload", "fastLightTextureUpload"}) {
+                out.append(',');
+                try { out.append(config == null ? "unknown" : config.getClass().getField(key).get(config)); }
+                catch (Throwable error) { out.append("unknown"); }
+            }
+            write("effective-settings.csv", out.append('\n').toString(), true);
+        } catch (Throwable error) { note("settings_sample_unavailable " + error.getClass().getSimpleName()); }
+    }
+
+    private static void rows(long epoch, long origin) throws Exception {
+        StringBuilder out = new StringBuilder();
+        for (int metric = 0; metric < PerformanceCounters.NAMES.length; metric++) {
+            out.append(epoch).append(',').append(epoch - origin).append(',').append(PerformanceCounters.NAMES[metric]).append(',').append(PerformanceCounters.COUNT[metric]).append(',').append(PerformanceCounters.NANOS[metric]).append(',').append(PerformanceCounters.PIXELS[metric]).append(',');
+            for (int i = 0; i < PerformanceCounters.BOUNDS.length; i++) out.append(PerformanceCounters.HISTOGRAM[metric * PerformanceCounters.BOUNDS.length + i]).append('|');
+            out.append('\n');
+        }
+        write("calls.csv", out.toString(), true);
+    }
+
+    private static synchronized void write(String suffix, String text, boolean append) throws Exception {
+        File file = new File(base + "-" + suffix);
+        if (append && file.length() > 2 * 1024 * 1024) return;
+        try (FileWriter writer = new FileWriter(file, append)) { writer.write(text); }
+    }
+    private static void note(String message) {
+        try { write("status.txt", System.currentTimeMillis() + " " + message + "\n", true); }
+        catch (Throwable ignored) { System.err.println("[Wachiland performance] " + message); }
+    }
+}
diff --git a/FCL/performance-probe/src/main/java/net/wachiland/performance/PerformanceCounters.java b/FCL/performance-probe/src/main/java/net/wachiland/performance/PerformanceCounters.java
new file mode 100644
index 0000000..a1eae68
--- /dev/null
+++ b/FCL/performance-probe/src/main/java/net/wachiland/performance/PerformanceCounters.java
@@ -0,0 +1,51 @@
+package net.wachiland.performance;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+/** Bootstrap-visible counters. No game, ASM, Android or GL dependencies. */
+public final class PerformanceCounters {
+    public static final String[] NAMES = {"frame", "client_tick", "texture_tick", "image_upload", "gl_texture_upload", "swap", "world_render", "ambient_tick", "placement_helpers", "async_post_tick", "terrain_draw"};
+    public static final long[] BOUNDS = {1000000, 2000000, 4000000, 8000000, 16000000, 33000000, 66000000, 125000000, 250000000, 500000000, 1000000000, 2000000000, Long.MAX_VALUE};
+    public static final AtomicLong[] COUNT = counters(NAMES.length);
+    public static final AtomicLong[] NANOS = counters(NAMES.length);
+    public static final AtomicLong[] PIXELS = counters(NAMES.length);
+    public static final AtomicLong[] HISTOGRAM = counters(NAMES.length * BOUNDS.length);
+    public static volatile boolean active;
+    public static volatile long firstWorld;
+    private static final ThreadLocal<int[]> DEPTH = ThreadLocal.withInitial(() -> new int[NAMES.length]);
+
+    private static AtomicLong[] counters(int size) {
+        AtomicLong[] values = new AtomicLong[size];
+        for (int i = 0; i < size; i++) values[i] = new AtomicLong();
+        return values;
+    }
+
+    public static long enter(int metric) {
+        try {
+            if (metric == 6 && firstWorld == 0) firstWorld = System.currentTimeMillis();
+            if (!active) return 0;
+            if (DEPTH.get()[metric]++ != 0) return -1;
+            return System.nanoTime();
+        } catch (Throwable ignored) { return 0; }
+    }
+
+    public static void exit(int metric, long start) {
+        try {
+            if (start == 0) return;
+            DEPTH.get()[metric]--;
+            if (start < 0) return;
+            long elapsed = Math.max(0, System.nanoTime() - start);
+            NANOS[metric].addAndGet(elapsed);
+            COUNT[metric].incrementAndGet();
+            int bucket = 0;
+            while (elapsed > BOUNDS[bucket]) bucket++;
+            HISTOGRAM[metric * BOUNDS.length + bucket].incrementAndGet();
+        } catch (Throwable ignored) { }
+    }
+
+    public static void pixels(int width, int height) {
+        try {
+            if (active && width > 0 && height > 0) PIXELS[4].addAndGet((long) width * height);
+        } catch (Throwable ignored) { }
+    }
+}
