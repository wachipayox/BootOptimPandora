@@ -0,0 +1,38 @@
+package net.wachiland.launcher;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+/** Optional profile presentation is not required by the signed manifest schema.
+ * Keep its interpretation outside UI callbacks and always return usable text. */
+final class ProfilePresentation {
+    private static final String DEFAULT_DESCRIPTION = "Perfil de Wachiland Distribution";
+
+    static String name(JsonObject summary) {
+        String title = string(object(summary, "presentation"), "name");
+        if (title == null || title.trim().isEmpty()) title = string(summary, "name");
+        if (title == null || title.trim().isEmpty()) title = string(summary, "profile_id");
+        return title == null || title.trim().isEmpty() ? "Perfil global" : title;
+    }
+
+    static String description(JsonObject summary, JsonObject manifest) {
+        String description = string(object(summary, "presentation"), "description");
+        // An explicit empty presentation description must not resurrect an older one.
+        if (description == null) description = string(object(manifest, "profile"), "description");
+        if (description != null && !description.trim().isEmpty()) return description;
+        String minecraft = string(object(manifest, "game"), "minecraft");
+        return minecraft == null || minecraft.trim().isEmpty()
+                ? DEFAULT_DESCRIPTION : "Minecraft " + minecraft;
+    }
+
+    private static JsonObject object(JsonObject parent, String key) {
+        JsonElement value = parent == null ? null : parent.get(key);
+        return value != null && value.isJsonObject() ? value.getAsJsonObject() : null;
+    }
+
+    private static String string(JsonObject parent, String key) {
+        JsonElement value = parent == null ? null : parent.get(key);
+        return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isString()
+                ? value.getAsString() : null;
+    }
+}
