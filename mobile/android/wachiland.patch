index 0000000..a5ecf18
--- /dev/null
+++ b/FCL/src/main/java/net/wachiland/launcher/PerformanceDiagnostics.kt
@@ -0,0 +1,100 @@
+package net.wachiland.launcher
+
+import android.content.Context
+import com.tungsten.fclauncher.utils.FCLPath
+import org.json.JSONObject
+import java.io.File
+import java.io.RandomAccessFile
+import java.nio.file.Files
+import java.nio.file.StandardCopyOption.REPLACE_EXISTING
+
+/** One armed launch, local files only. Independent of the deep heap/JFR experiment. */
+object PerformanceDiagnostics {
+    private const val PREFS = "wachiland_process_diagnostics"
+    private var cursor = 0L
+    private var verified = false
+    private var joined = false
+    private var jeiReady = false
+    private var requested = false
+    @Volatile private var enabledForSession = false
+    fun armed(context: Context) = context.getSharedPreferences(PREFS, 0).getBoolean("performance_next", true)
+    fun arm(context: Context, enabled: Boolean) { context.getSharedPreferences(PREFS, 0).edit().putBoolean("performance_next", enabled).apply() }
+    fun begin(enabled: Boolean) {
+        cursor = 0; verified = false; joined = false; jeiReady = false; requested = false
+        enabledForSession = enabled
+    }
+    fun prepare(context: Context, prefix: String, java17: Boolean, gameDir: File): List<String> {
+        if (!enabledForSession) return emptyList()
+        val dir = File(context.filesDir, "exit-diagnostics")
+        val base = File(dir, "$prefix-performance")
+        if (!java17) {
+            File("$base-status.txt").writeText("agent_skipped_runtime_below_17_unknown_or_instrument_library_missing\n")
+            enabledForSession = false
+            return emptyList()
+        }
+        val jar = File(context.filesDir, "wachiland-performance-probe.jar")
+        val bootstrap = File(context.filesDir, "wachiland-performance-counters.jar")
+        for (target in listOf(jar, bootstrap)) {
+            val staged = File(context.filesDir, target.name + ".tmp")
+            try {
+                context.assets.open("game/${target.name}").use { input -> staged.outputStream().use { input.copyTo(it) } }
+                Files.move(staged.toPath(), target.toPath(), REPLACE_EXISTING)
+            } finally { staged.delete() }
+        }
+        arm(context, false)
+        snapshot(gameDir, File("$base-settings.json"))
+        File("$base-status.txt").writeText("launcher_prepared=true\nepoch_ms=${System.currentTimeMillis()}\n")
+        return listOf("--add-exports=java.base/jdk.internal.org.objectweb.asm=ALL-UNNAMED",
+            "--add-exports=java.base/jdk.internal.org.objectweb.asm.commons=ALL-UNNAMED",
+            "--add-exports=java.base/jdk.internal.org.objectweb.asm.util=ALL-UNNAMED",
+            "-Dwachiland.performance.bootstrap=${bootstrap.absolutePath}", "-Dwachiland.performance.base=${base.absolutePath}",
+            "-javaagent:${jar.absolutePath}")
+    }
+    fun checkpoint(context: Context, prefix: String, origin: Long) {
+        if (!enabledForSession || requested) return
+        val log = FCLPath.getLatestGameLog()
+        if (!log.isFile || log.lastModified() < origin) return
+        val text = RandomAccessFile(log, "r").use { input ->
+            if (input.length() < cursor) { cursor = 0; verified = false; joined = false; jeiReady = false }
+            input.seek((cursor - 512).coerceAtLeast(0))
+            val bytes = ByteArray(minOf(131072L, input.length() - input.filePointer).toInt())
+            input.readFully(bytes); cursor = input.filePointer; bytes.toString(Charsets.UTF_8)
+        }
+        if (text.contains("-Dwachiland.memory.origin=$origin")) verified = true
+        if (!verified) return
+        if (text.contains(" logged in with entity id ")) joined = true
+        if (text.contains("Starting JEI took")) jeiReady = true
+        if (!joined || !jeiReady) return
+        val request = File(context.filesDir, "exit-diagnostics/$prefix-performance-request.txt")
+        request.writeText("epoch_ms=${System.currentTimeMillis()}; matched_origin=$origin; world_join_and_jei=true\n")
+        requested = true
+    }
+    private fun snapshot(gameDir: File, output: File) {
+        val result = JSONObject().put("epoch_ms", System.currentTimeMillis()).put("scope", "launch_only_allowlisted_settings")
+        val allowed = setOf("enabled", "cache", "fastUpload", "fastLightTextureUpload", "bufferSize", "tickAsync", "asyncTick", "renderAsync", "asyncRender", "deferredTextureTick", "animateTickAsync", "asyncAnimateTick", "threads", "parallelism", "animationTickMode", "particleTickMode", "particleRenderingMode", "gpuAcceleration", "particleLightCache", "parallelQueueRemoval", "parallelQueueEviction")
+        for (name in listOf("kerria.json", "asyncparticles/asyncparticles.json", "asyncparticles.json", "asyncparticles-config.json")) {
+            val file = File(gameDir, "config/$name")
+            val row = JSONObject().put("present", file.isFile)
+            if (file.isFile && file.length() <= 256 * 1024) runCatching {
+                val source = JSONObject(file.readText())
+                fun collect(obj: JSONObject, path: String) {
+                    for (key in obj.keys()) {
+                        val value = obj.opt(key)
+                        if (value is JSONObject) collect(value, "$path$key.")
+                        else if (key in allowed && (value is Boolean || value is Number || value is String)) row.put("$path$key", if (value is String) value.take(128) else value)
+                    }
+                }
+                collect(source, "")
+            }.onFailure { row.put("parse_error", it.javaClass.simpleName) }
+            result.put(name, row)
+        }
+        val options = File(gameDir, "options.txt")
+        val values = JSONObject()
+        if (options.isFile && options.length() <= 256 * 1024) options.useLines { lines -> lines.forEach { line ->
+            val key = line.substringBefore(':')
+            if (key in setOf("maxFps", "enableVsync", "renderDistance", "simulationDistance", "graphicsMode", "mipmapLevels")) values.put(key, line.substringAfter(':').take(128))
+        } }
+        result.put("options", values)
+        output.writeText(result.toString(2))
+    }
+}
diff --git a/FCL/src/main/java/net/wachiland/launcher/ProcessExitDiagnostics.kt b/FCL/src/main/java/net/wachiland/launcher/ProcessExitDiagnostics.kt
