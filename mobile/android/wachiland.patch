diff --git a/FCL/memory-probe/src/main/java/net/wachiland/diagnostics/MemoryMain.java b/FCL/memory-probe/src/main/java/net/wachiland/diagnostics/MemoryMain.java
new file mode 100644
index 0000000..de961ed
--- /dev/null
+++ b/FCL/memory-probe/src/main/java/net/wachiland/diagnostics/MemoryMain.java
@@ -0,0 +1,85 @@
+package net.wachiland.diagnostics;
+
+import java.io.File;
+import java.io.FileWriter;
+import java.lang.management.BufferPoolMXBean;
+import java.lang.management.GarbageCollectorMXBean;
+import java.lang.management.ManagementFactory;
+import java.lang.management.MemoryUsage;
+import java.lang.reflect.InvocationTargetException;
+
+/** Runs in embedded OpenJDK, never in Android ART. No transforms or forced GC. */
+public final class MemoryMain {
+    private static final String HEADER = "epoch_ms,session_elapsed_ms,heap_used_bytes,heap_committed_bytes,heap_max_bytes,nonheap_used_bytes,nonheap_committed_bytes,direct_used_bytes,mapped_used_bytes,gc_count,gc_time_ms,threads,sample_duration_ms\n";
+
+    public static void main(String[] args) throws Throwable {
+        try { start(); } catch (Throwable e) {
+            System.err.println("[Wachiland memory] Optional probe unavailable: " + e.getClass().getName());
+        }
+        // Keep the upstream wrapper and its launch/error handling intact.
+        try {
+            Class.forName("mio.Wrapper").getMethod("main", String[].class).invoke(null, (Object) args);
+        } catch (InvocationTargetException e) { throw e.getCause(); }
+    }
+
+    private static void start() throws Exception {
+        final File csv = new File(System.getProperty("wachiland.memory.file"));
+        final long origin = Long.parseLong(System.getProperty("wachiland.memory.origin"));
+        write(csv, HEADER, false);
+        write(new File(csv.getParentFile(), csv.getName().replace("jvm.csv", "jvm-info.txt")),
+                "Runtime: embedded OpenJDK, not Android ART\njava.version=" + System.getProperty("java.version") +
+                "\njava.vm.name=" + System.getProperty("java.vm.name") + "\norigin_epoch_ms=" + origin +
+                "\nUnits: bytes except times/counts. Heap committed is not resident memory.\n" +
+                "Direct buffers do not include all LWJGL/mod/driver allocations. Missing metrics = -1.\n", false);
+        Thread sampler = new Thread(new Runnable() {
+            @Override public void run() {
+                // Bounded to three hours; retain flushed partial data on SIGKILL.
+                for (int i = 0; i < 1080; i++) {
+                    try { sample(csv, origin); }
+                    catch (Throwable e) {
+                        try { write(new File(csv.getParentFile(), csv.getName().replace("jvm.csv", "jvm-errors.txt")),
+                                System.currentTimeMillis() + " " + e.getClass().getName() + "\n", true); }
+                        catch (Throwable ignored) { }
+                        return;
+                    }
+                    try { Thread.sleep(10000); } catch (InterruptedException e) { return; }
+                }
+            }
+        }, "Wachiland-game-memory");
+        sampler.setDaemon(true);
+        sampler.setPriority(Thread.MIN_PRIORITY);
+        sampler.start();
+        System.out.println("[Wachiland memory] Embedded JVM recording enabled, 10 s interval; no heap/settings changes.");
+    }
+
+    private static void sample(File csv, long origin) throws Exception {
+        long tick = System.nanoTime();
+        long epoch = System.currentTimeMillis();
+        Runtime runtime = Runtime.getRuntime();
+        long committed = runtime.totalMemory(), used = committed - runtime.freeMemory();
+        long nonheap = -1, nonheapCommitted = -1, direct = -1, mapped = -1, gc = -1, gcTime = -1, threads = -1;
+        // Some mobile runtimes omit java.management; Runtime heap sampling still works.
+        try {
+            MemoryUsage usage = ManagementFactory.getMemoryMXBean().getNonHeapMemoryUsage();
+            nonheap = usage.getUsed(); nonheapCommitted = usage.getCommitted();
+            for (BufferPoolMXBean pool : ManagementFactory.getPlatformMXBeans(BufferPoolMXBean.class)) {
+                if (pool.getName().equals("direct")) direct = pool.getMemoryUsed();
+                if (pool.getName().equals("mapped")) mapped = pool.getMemoryUsed();
+            }
+            gc = 0; gcTime = 0;
+            for (GarbageCollectorMXBean collector : ManagementFactory.getGarbageCollectorMXBeans()) {
+                if (collector.getCollectionCount() >= 0) gc += collector.getCollectionCount();
+                if (collector.getCollectionTime() >= 0) gcTime += collector.getCollectionTime();
+            }
+            threads = ManagementFactory.getThreadMXBean().getThreadCount();
+        } catch (Throwable ignored) { }
+        if (csv.length() > 4 * 1024 * 1024) return;
+        write(csv, epoch + "," + (epoch - origin) + "," + used + "," + committed + "," + runtime.maxMemory() +
+                "," + nonheap + "," + nonheapCommitted + "," + direct + "," + mapped + "," + gc + "," + gcTime +
+                "," + threads + "," + ((System.nanoTime() - tick) / 1000000) + "\n", true);
+    }
+
+    private static void write(File file, String text, boolean append) throws Exception {
+        try (FileWriter out = new FileWriter(file, append)) { out.write(text); }
+    }
+}
