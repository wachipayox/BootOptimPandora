@@ -0,0 +1,68 @@
+package net.wachiland.launcher;
+
+import com.google.gson.*;
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.*;
+import java.util.regex.*;
+
+/** Conservative initial-install rules. Unsupported syntax fails rather than corrupting a config. */
+final class ConfigRules {
+    static void apply(File root, JsonObject rule) throws IOException {
+        String path=rule.get("path").getAsString(); DistributionClient.validatePath(path);
+        File file=new File(root,path); DistributionClient.safeDestination(root,file);
+        if (!file.isFile() || file.length()>4*1024*1024) throw new IOException("Configuración ausente o demasiado grande: "+path);
+        String format=rule.get("format").getAsString(), key=rule.get("key").getAsString();
+        String policy=rule.get("policy").getAsString();
+        if (!Set.of("enforced","default_once").contains(policy)) throw new IOException("Política de configuración incompatible");
+        String text=new String(Files.readAllBytes(file.toPath()),StandardCharsets.UTF_8);
+        String newline=text.contains("\r\n") ? "\r\n" : "\n";
+        List<String> lines=new ArrayList<>(Arrays.asList(text.split("\\r?\\n",-1)));
+        JsonElement value=rule.get("value"); boolean changed=false;
+        if (format.equals("text_lines")) {
+            int line;
+            try { line=Integer.parseInt(key.startsWith("line:")?key.substring(5):key); } catch (NumberFormatException e) { throw new IOException("Número de línea TXT incompatible",e); }
+            if (line<1 || line>lines.size() || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString()) throw new IOException("Regla TXT incompatible");
+            String replacement=value.getAsString(); if (replacement.contains("\n") || replacement.contains("\r")) throw new IOException("La regla TXT debe ser una sola línea");
+            lines.set(line-1,replacement); changed=true;
+        } else if (format.equals("properties")) {
+            if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString()) throw new IOException("Regla properties incompatible");
+            String replacement=value.getAsString().replace("\\","\\\\").replace("\n","\\n").replace("\r","\\r");
+            for(int i=0;i<lines.size();i++) {
+                String s=lines.get(i).trim(); if(s.startsWith("#") || s.startsWith("!")) continue;
+                Matcher matcher=Pattern.compile("^\\s*([^:=\\s]+)\\s*[:=]\\s*.*$").matcher(lines.get(i));
+                if(matcher.matches() && matcher.group(1).equals(key)) { if(changed) throw new IOException("Clave duplicada: "+key); lines.set(i,key+"="+replacement); changed=true; }
+            }
+            if(!changed) { lines.add(key+"="+replacement); changed=true; }
+        } else if (format.equals("toml")) {
+            // Validate the input and only edit ordinary dotted keys/table assignments.
+            if(org.tomlj.Toml.parse(text).hasErrors()) throw new IOException("TOML inválido: "+path);
+            String table=""; int lastDot=key.lastIndexOf('.');
+            String wantedTable=lastDot<0 ? "" : key.substring(0,lastDot), leaf=lastDot<0 ? key : key.substring(lastDot+1);
+            if (!key.matches("[A-Za-z0-9_.-]+")) throw new IOException("Esta clave TOML necesita el editor completo: "+key);
+            String replacement=toml(value);
+            for(int i=0;i<lines.size();i++) {
+                String s=lines.get(i).trim();
+                if(s.startsWith("[") && s.endsWith("]")) table=s.substring(1,s.length()-1).trim();
+                Matcher matcher=Pattern.compile("^\\s*([A-Za-z0-9_.-]+)\\s*=.*$").matcher(lines.get(i));
+                if(matcher.matches() && ((table.isEmpty()?"":table+".")+matcher.group(1)).equals(key)) {
+                    if(changed) throw new IOException("Clave TOML duplicada: "+key);
+                    if(s.contains("\"\"\"") || s.contains("'''")) throw new IOException("Valor TOML multilínea no compatible en el prototipo");
+                    lines.set(i,matcher.group(1)+" = "+replacement); changed=true;
+                }
+            }
+            if(!changed) {
+                lines.add(""); if(!wantedTable.isEmpty()) lines.add("["+wantedTable+"]");
+                lines.add(leaf+" = "+replacement); changed=true;
+            }
+            if(org.tomlj.Toml.parse(String.join(newline,lines)).hasErrors()) throw new IOException("La regla genera un TOML inválido: "+key);
+        } else throw new IOException("Formato de reglas no compatible: "+format);
+        if(changed) Files.write(file.toPath(),String.join(newline,lines).getBytes(StandardCharsets.UTF_8));
+    }
+    private static String toml(JsonElement value) throws IOException {
+        if(value.isJsonPrimitive()) return value.toString();
+        if(value.isJsonArray()) { List<String> result=new ArrayList<>(); for(JsonElement item:value.getAsJsonArray()) result.add(toml(item)); return "["+String.join(", ",result)+"]"; }
+        throw new IOException("Valor TOML no compatible en el prototipo");
+    }
+}
