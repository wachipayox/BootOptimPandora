@@ -0,0 +1,257 @@
+package net.wachiland.launcher;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.util.Base64;
+import com.google.gson.*;
+import org.erdtman.jcs.JsonCanonicalizer;
+import org.bouncycastle.crypto.params.Ed25519PublicKeyParameters;
+import org.bouncycastle.crypto.signers.Ed25519Signer;
+import java.io.*;
+import java.net.*;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.security.MessageDigest;
+import java.util.*;
+import java.util.zip.ZipFile;
+
+/** Android transport for the same pinned Distribution protocol as Pandora.
+ * This prototype only installs fresh instances; it never reconciles an existing tree. */
+public final class DistributionClient {
+    public static final String DEFAULT_SERVER = "https://welite.ddns.net";
+    private final Context context;
+    private final String origin;
+    private JsonObject keys;
+    public interface Progress { void update(String path, long done, long total); }
+    public static final class Plan {
+        public JsonObject profile, manifest;
+        public final Map<String, JsonObject> files = new TreeMap<>();
+        public final Map<String, JsonObject> settings = new LinkedHashMap<>();
+        public long bytes;
+    }
+    public DistributionClient(Context context) throws IOException {
+        this.context = context.getApplicationContext();
+        origin = this.context.getSharedPreferences("wachiland", 0).getString("server", DEFAULT_SERVER);
+        URI uri = URI.create(origin);
+        if (!"https".equals(uri.getScheme()) || uri.getHost() == null || uri.getUserInfo() != null
+                || uri.getQuery() != null || uri.getFragment() != null || !uri.getPath().isEmpty())
+            throw new IOException("La dirección de Distribution debe ser un origen HTTPS sin ruta.");
+    }
+    private HttpURLConnection connect(String path) throws IOException {
+        HttpURLConnection c = (HttpURLConnection) new URL(origin + path).openConnection();
+        c.setInstanceFollowRedirects(false);
+        c.setConnectTimeout(15000); c.setReadTimeout(30000);
+        c.setRequestProperty("User-Agent", "Wachiland-Android/0.1.3");
+        if (c.getResponseCode() != 200) {
+            int code = c.getResponseCode(); c.disconnect();
+            throw new IOException("Distribution HTTP " + code + " en " + path);
+        }
+        return c;
+    }
+    private JsonObject json(String path) throws IOException {
+        HttpURLConnection c = connect(path);
+        try (InputStream in = c.getInputStream(); ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+            String type = c.getContentType();
+            if (type == null || !type.toLowerCase(Locale.ROOT).startsWith("application/json"))
+                throw new IOException("El servidor no sirve la API de Distribution en " + origin
+                    + ". Respuesta recibida: " + (type == null ? "sin tipo de contenido" : type));
+            byte[] buffer = new byte[16384]; int n;
+            while ((n = in.read(buffer)) >= 0) {
+                if (out.size() + n > 4*1024*1024) throw new IOException("Respuesta JSON demasiado grande");
+                out.write(buffer, 0, n);
+            }
+            return JsonParser.parseString(out.toString("UTF-8")).getAsJsonObject();
+        } catch (RuntimeException e) { throw new IOException("Respuesta JSON inválida", e); }
+        finally { c.disconnect(); }
+    }
+    public List<JsonObject> catalog() throws IOException {
+        JsonObject response = json("/v1/profiles");
+        if (response.get("schema_version").getAsInt() != 1 || response.get("protocol_version").getAsInt() != 1
+                || response.has("truncated") && response.get("truncated").getAsBoolean())
+            throw new IOException("Catálogo incompatible o incompleto");
+        List<JsonObject> result = new ArrayList<>(); Set<String> seen = new HashSet<>();
+        for (JsonElement e : response.getAsJsonArray("profiles")) {
+            JsonObject p = e.getAsJsonObject(); identifier(p.get("profile_id").getAsString(), "profile_");
+            if (!seen.add(p.get("profile_id").getAsString())) throw new IOException("Perfil duplicado");
+            result.add(p);
+        }
+        return result;
+    }
+    private JsonObject revision(String id, JsonObject ref) throws Exception {
+        identifier(id, "profile_");
+        String revision = ref.get("revision_id").getAsString(); identifier(revision, "rev_");
+        String expected = ref.get("manifest_sha256").getAsString(); digest(expected);
+        JsonObject response = json("/v1/profiles/"+id+"/revisions/"+revision);
+        if (response.get("schema_version").getAsInt()!=1 || response.get("protocol_version").getAsInt()!=1)
+            throw new IOException("Protocolo de revisión incompatible");
+        JsonObject env = response.getAsJsonObject("envelope"), sig = env.getAsJsonObject("signature");
+        JsonObject m = env.getAsJsonObject("manifest");
+        byte[] canonical = new JsonCanonicalizer(m.toString()).getEncodedUTF8();
+        if (!"RFC8785-JCS".equals(env.get("canonicalization").getAsString())
+                || !"Ed25519".equals(sig.get("algorithm").getAsString())
+                || !expected.equals(env.get("manifest_sha256").getAsString())
+                || !expected.equals(hex(MessageDigest.getInstance("SHA-256").digest(canonical))))
+            throw new IOException("La revisión no coincide con su hash firmado");
+        if (keys == null) keys = json("/v1/signing-keys").getAsJsonObject("keys");
+        String keyId = sig.get("key_id").getAsString();
+        if (!keys.has(keyId)) throw new IOException("Identidad de firma desconocida");
+        String encoded = keys.get(keyId).getAsString();
+        SharedPreferences trust = context.getSharedPreferences("wachiland-signers", 0);
+        String saved = trust.getString(origin + "|" + keyId, encoded);
+        if (!saved.equals(encoded)) throw new IOException("La identidad de firma del servidor ha cambiado");
+        Ed25519Signer verifier = new Ed25519Signer();
+        verifier.init(false, new Ed25519PublicKeyParameters(decode(encoded), 0));
+        verifier.update(canonical, 0, canonical.length);
+        if (!verifier.verifySignature(decode(sig.get("value").getAsString())))
+            throw new IOException("Firma de revisión inválida");
+        trust.edit().putString(origin + "|" + keyId, encoded).apply();
+        if (!id.equals(m.getAsJsonObject("profile").get("id").getAsString())
+                || !revision.equals(m.getAsJsonObject("revision").get("id").getAsString())
+                || ref.has("sequence") && ref.get("sequence").getAsLong()!=m.getAsJsonObject("revision").get("sequence").getAsLong()
+                || m.get("schema_version").getAsInt()<1 || m.get("schema_version").getAsInt()>2)
+            throw new IOException("Identidad o esquema de revisión incompatible");
+        return m;
+    }
+    public Plan resolve(JsonObject profile) throws Exception {
+        Plan plan = new Plan(); plan.profile = profile.deepCopy();
+        String id = profile.get("profile_id").getAsString(); JsonObject ref = profile.getAsJsonObject("latest_revision");
+        List<JsonObject> chain = new ArrayList<>(); Set<String> seen = new HashSet<>();
+        while (true) {
+            if (chain.size() >= 9 || !seen.add(id+":"+ref.get("revision_id").getAsString()))
+                throw new IOException("La herencia contiene un ciclo o más de ocho madres");
+            JsonObject m = revision(id, ref); chain.add(m);
+            if (!m.has("base") || m.get("base").isJsonNull()) break;
+            ref = m.getAsJsonObject("base"); id = ref.get("profile_id").getAsString();
+        }
+        plan.manifest = chain.get(0);
+        if (chain.size()-1 > plan.manifest.getAsJsonObject("permissions").get("max_inheritance_depth").getAsInt())
+            throw new IOException("La herencia excede el límite firmado");
+        Map<String,String> identities = new HashMap<>();
+        JsonObject previousPermissions = null;
+        for (int i=chain.size()-1; i>=0; i--) {
+            JsonObject m = chain.get(i);
+            if (!m.get("game").equals(plan.manifest.get("game"))) throw new IOException("Las madres usan otra versión de Minecraft");
+            for (String collection : new String[]{"mods", "configs", "objects"}) {
+                for (JsonElement e : array(m, collection)) {
+                    JsonObject entry = e.getAsJsonObject(); String path = entry.get("path").getAsString(); validatePath(path);
+                    String identity = collection+":"+(collection.equals("configs") ? path : entry.get("id").getAsString());
+                    String old = identities.get(identity);
+                    if (entry.has("expect_base_object_sha256") && !entry.get("expect_base_object_sha256").isJsonNull()) {
+                        if (old==null || !plan.files.get(old).getAsJsonObject("object").get("sha256").equals(entry.get("expect_base_object_sha256")))
+                            throw new IOException("El archivo base no coincide: "+path);
+                    }
+                    if (old!=null && !old.equals(path)) plan.files.remove(old);
+                    if (plan.files.containsKey(path) && (old==null || !old.equals(path)))
+                        throw new IOException("Dos identidades intentan escribir "+path);
+                    JsonObject object = entry.getAsJsonObject("object"); validateObject(object);
+                    plan.files.put(path, entry); identities.put(identity,path);
+                }
+            }
+            for (String collection : new String[]{"remove_mods", "remove_configs"}) {
+                for (JsonElement e : array(m, collection)) {
+                    JsonObject entry=e.getAsJsonObject();
+                    String identity = collection.equals("remove_mods") ? "mods:"+entry.get("id").getAsString() : "configs:"+entry.get("path").getAsString();
+                    String path = identities.remove(identity);
+                    if (path==null || !plan.files.get(path).getAsJsonObject("object").get("sha256").equals(entry.get("expect_base_object_sha256")))
+                        throw new IOException("La eliminación no coincide con la madre");
+                    plan.files.remove(path);
+                    final String removed = path; plan.settings.entrySet().removeIf(item -> item.getValue().get("path").getAsString().equals(removed));
+                }
+            }
+            for (JsonElement e : array(m,"config_settings")) {
+                if (m.get("schema_version").getAsInt()!=2) throw new IOException("Reglas de configuración incompatibles");
+                JsonObject rule=e.getAsJsonObject(); validatePath(rule.get("path").getAsString());
+                String identity=rule.get("path").getAsString()+"\0"+rule.get("key").getAsString();
+                if (plan.settings.containsKey(identity)) {
+                    String policy=plan.settings.get(identity).get("policy").getAsString();
+                    if (previousPermissions==null || !previousPermissions.getAsJsonObject("configs").get("override_"+policy).getAsBoolean())
+                        throw new IOException("La madre no permite cambiar esta regla");
+                }
+                plan.settings.put(identity,rule);
+            }
+            previousPermissions=m.getAsJsonObject("permissions");
+        }
+        for (JsonObject entry : plan.files.values()) plan.bytes += entry.getAsJsonObject("object").get("size").getAsLong();
+        return plan;
+    }
+    public File object(JsonObject ref, Progress progress) throws Exception {
+        validateObject(ref); String digest=ref.get("sha256").getAsString(); long size=ref.get("size").getAsLong();
+        File dir=new File(context.getFilesDir(), "distribution-cas"); if (!dir.isDirectory() && !dir.mkdirs()) throw new IOException("No se puede crear la caché");
+        File output=new File(dir,digest);
+        if (output.isFile() && output.length()==size && digest.equals(hash(output))) return output;
+        File temporary=File.createTempFile("download-", ".part",dir);
+        HttpURLConnection c=connect("/v1/objects/sha256/"+digest);
+        try (InputStream in=c.getInputStream(); FileOutputStream out=new FileOutputStream(temporary)) {
+            MessageDigest sha=MessageDigest.getInstance("SHA-256"); byte[] buffer=new byte[65536]; long count=0; int n;
+            while ((n=in.read(buffer))>=0) {
+                if (Thread.currentThread().isInterrupted()) throw new InterruptedIOException("Descarga cancelada");
+                count+=n; if (count>size) throw new IOException("El objeto supera el tamaño firmado");
+                sha.update(buffer,0,n); out.write(buffer,0,n); progress.update(digest,count,size);
+            }
+            if (count!=size || !digest.equals(hex(sha.digest()))) throw new IOException("Hash o tamaño incorrectos: "+digest);
+            out.getFD().sync();
+        } catch (Exception e) { temporary.delete(); throw e; } finally { c.disconnect(); }
+        Files.move(temporary.toPath(),output.toPath(),StandardCopyOption.REPLACE_EXISTING);
+        return output;
+    }
+    public void install(Plan plan, File directory, File icon, Progress progress) throws Exception {
+        long done=0;
+        for (Map.Entry<String,JsonObject> item : plan.files.entrySet()) {
+            String path=item.getKey(); long before=done;
+            File source=object(item.getValue().getAsJsonObject("object"),(p,d,t)->progress.update(path,before+d,plan.bytes));
+            if (path.startsWith("mods/") && path.endsWith(".jar")) try (ZipFile ignored=new ZipFile(source)) { }
+            File destination=new File(directory,path); safeDestination(directory,destination);
+            File parent=destination.getParentFile(); if (!parent.isDirectory() && !parent.mkdirs()) throw new IOException("No se puede crear "+path);
+            if (destination.exists()) throw new IOException("La instancia nueva ya contiene "+path);
+            Files.copy(source.toPath(),destination.toPath());
+            done+=source.length(); progress.update(path,done,plan.bytes);
+        }
+        for (JsonObject setting : plan.settings.values()) ConfigRules.apply(directory,setting);
+        JsonObject art=presentationIcon(plan.profile,plan.manifest);
+        if (art!=null) { validateIcon(art); Files.copy(object(art,(p,d,t)->{}).toPath(),icon.toPath(),StandardCopyOption.REPLACE_EXISTING); }
+        File pin=new File(directory,".wachiland-profile.json");
+        Files.write(pin.toPath(),plan.profile.toString().getBytes(StandardCharsets.UTF_8));
+    }
+    public static JsonObject presentationIcon(JsonObject p, JsonObject m) {
+        if (p.has("presentation") && !p.get("presentation").isJsonNull()) {
+            JsonObject art=p.getAsJsonObject("presentation");
+            if (art.has("icon") && !art.get("icon").isJsonNull()) return art.getAsJsonObject("icon");
+        }
+        if (m!=null && m.getAsJsonObject("profile").has("icon") && !m.getAsJsonObject("profile").get("icon").isJsonNull())
+            return m.getAsJsonObject("profile").getAsJsonObject("icon");
+        return null;
+    }
+    public static void validateIcon(JsonObject ref) throws IOException {
+        validateObject(ref);
+        if (ref.get("size").getAsLong()>2*1024*1024 || !"image/png".equals(ref.get("media_type").getAsString())) throw new IOException("Icono inválido");
+    }
+    static void safeDestination(File root,File file) throws IOException {
+        if (!file.getCanonicalPath().startsWith(root.getCanonicalPath()+File.separator)) throw new IOException("Ruta fuera de la instancia");
+        File parent=file;
+        while (parent!=null && !parent.equals(root)) { if (Files.isSymbolicLink(parent.toPath())) throw new IOException("Enlace no permitido durante la instalación"); parent=parent.getParentFile(); }
+    }
+    static void validatePath(String path) throws IOException {
+        if (path.isEmpty() || path.startsWith("/") || path.contains("\\") || path.contains(":") || path.indexOf('\0')>=0)
+            throw new IOException("Ruta insegura: "+path);
+        for (String part:path.split("/",-1)) if (part.isEmpty() || part.equals(".") || part.equals("..")) throw new IOException("Ruta insegura: "+path);
+        String first=path.split("/",2)[0].toLowerCase(Locale.ROOT);
+        if (Set.of("saves","screenshots","logs","crash-reports",".pandora-layout-v1",".wachiland-profile.json").contains(first))
+            throw new IOException("El perfil intenta administrar datos del jugador: "+path);
+    }
+    private static void identifier(String value,String prefix) throws IOException {
+        if (!value.startsWith(prefix) || !value.matches("[A-Za-z0-9_-]{1,160}")) throw new IOException("Identificador inválido");
+    }
+    private static void digest(String value) throws IOException { if (!value.matches("[0-9a-f]{64}")) throw new IOException("SHA-256 inválido"); }
+    private static void validateObject(JsonObject object) throws IOException {
+        digest(object.get("sha256").getAsString()); long size=object.get("size").getAsLong();
+        if (size<0 || size>2L*1024*1024*1024) throw new IOException("Tamaño de objeto inválido");
+    }
+    private static JsonArray array(JsonObject m,String key) { return m.has(key) ? m.getAsJsonArray(key) : new JsonArray(); }
+    private static byte[] decode(String s) { return Base64.decode(s,Base64.URL_SAFE|Base64.NO_WRAP|Base64.NO_PADDING); }
+    private static String hash(File file) throws Exception {
+        MessageDigest sha=MessageDigest.getInstance("SHA-256");
+        try(InputStream in=new FileInputStream(file)) { byte[] b=new byte[65536]; int n; while ((n=in.read(b))>=0) sha.update(b,0,n); }
+        return hex(sha.digest());
+    }
+    private static String hex(byte[] bytes) { StringBuilder result=new StringBuilder(); for(byte b:bytes) result.append(String.format(Locale.ROOT,"%02x",b&255)); return result.toString(); }
+}
diff --git a/FCL/src/main/java/net/wachiland/launcher/MemoryDiagnostics.kt b/FCL/src/main/java/net/wachiland/launcher/MemoryDiagnostics.kt
new file mode 100644
index 0000000..3b4f184
--- /dev/null
+++ b/FCL/src/main/java/net/wachiland/launcher/MemoryDiagnostics.kt
@@ -0,0 +1,247 @@
+package net.wachiland.launcher
+
+import android.app.ActivityManager
+import android.content.ComponentCallbacks2
+import android.content.Context
+import android.content.res.Configuration
+import android.os.Debug
+import android.os.Process
+import android.os.SystemClock
+import com.tungsten.fclauncher.utils.FCLPath
+import org.json.JSONObject
+import java.io.File
+import java.io.RandomAccessFile
+import java.nio.file.Files
+import java.nio.file.StandardCopyOption.REPLACE_EXISTING
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** ART/process probe. Embedded OpenJDK has a separate companion sampler. */
+object MemoryDiagnostics {
+    private const val PREFS = "wachiland_process_diagnostics"
+    private val active = AtomicBoolean(false)
+    @Volatile private var session: String? = null
+    @Volatile private var origin = 0L
+    @Volatile private var callbacks: ComponentCallbacks2? = null
+    @Volatile private var thread: Thread? = null
+    @Volatile private var deep = false
+    private var logCursor = 0L
+    private var menuRequested = false
+    private var logSessionVerified = false
+    private fun dir(context: Context) = File(context.filesDir, "exit-diagnostics").apply { mkdirs() }
+    @JvmStatic fun enabled(context: Context) = context.getSharedPreferences(PREFS, 0).getBoolean("memory_enabled", true)
+    fun setEnabled(context: Context, enabled: Boolean) { context.getSharedPreferences(PREFS, 0).edit().putBoolean("memory_enabled", enabled).apply() }
+    fun deepArmed(context: Context) = context.getSharedPreferences(PREFS, 0).getBoolean("heap_attribution_next", false)
+    fun armDeep(context: Context, armed: Boolean) { context.getSharedPreferences(PREFS, 0).edit().putBoolean("heap_attribution_next", armed).apply() }
+
+    @JvmStatic fun begin(context: Context, renderer: String) {
+        val performance = PerformanceDiagnostics.armed(context)
+        if ((!enabled(context) && !performance) || !active.compareAndSet(false, true)) return
+        val app = context.applicationContext
+        try {
+            origin = System.currentTimeMillis()
+            val prefix = "memory-${origin}-${Process.myPid()}"
+            session = prefix
+            deep = deepArmed(app) && !performance // Avoid stacking heavy heap probes on frame timing.
+            PerformanceDiagnostics.begin(performance)
+            app.getSharedPreferences(PREFS, 0).edit().putString("game_telemetry_prefix", prefix)
+                .putBoolean("game_performance_requested", performance).commit()
+            if (deep) armDeep(app, false) // Explicitly armed for one launch only, not every benchmark.
+            logCursor = 0L
+            menuRequested = false
+            logSessionVerified = false
+            // Keep two older sessions plus the new one, including Android and JVM sides.
+            val directory = dir(app)
+            val sessions = directory.listFiles().orEmpty().filter { it.name.startsWith("memory-") }
+                .mapNotNull { Regex("memory-\\d+-\\d+").find(it.name)?.value }.distinct().sortedDescending()
+            directory.listFiles().orEmpty().filter { file -> sessions.drop(2).any { file.name.startsWith("$it-") } }.forEach { it.delete() }
+            File(directory, "$prefix-info.txt").writeText("""
+                Session=$prefix; PID=${Process.myPid()}; origin_epoch_ms=$origin; renderer=$renderer
+                ART/native/status/system samples every 10 seconds; Debug.MemoryInfo every 30 seconds.
+                One initial mapping summary only; maximum 3 hours. Android meminfo keys absent between full samples.
+                Android JSON memory values in KiB except explicitly named *_bytes. Missing metrics absent/-1.
+                Runtime on Android measures ART only. The companion jvm.csv measures embedded OpenJDK.
+                PSS, RSS, private memory, heap used/committed and buffer counters overlap: DO NOT ADD THEM.
+                Heap used/committed is logical JVM memory, not its resident share. No exact subtraction from RSS.
+                summary.java-heap is ART classification, not Minecraft's heap. Anonymous mappings remain unattributed.
+                Graphics attribution is vendor dependent: absent or zero does not prove no GPU memory.
+                System available memory includes reclaimable pages. Total minus available is not other-app usage.
+                Other apps cannot be enumerated reliably without privileges. No root/USB required or attempted.
+                Proc mapping labels are heuristic categories; library file mappings do not include all its mallocs.
+                Basic mode: no forced GC, heap dumps, stack walks, NMT, uploads or mod/renderer/heap setting changes.
+                Deep attribution armed for this session: $deep. If true, see heap-status.txt for JFR/census cost and outcomes.
+            """.trimIndent() + "\n")
+            ThermalDiagnostics.begin(app, prefix)
+            val callback = object : ComponentCallbacks2 {
+                override fun onTrimMemory(level: Int) { event(app, prefix, "trim_memory", level) }
+                override fun onLowMemory() { event(app, prefix, "low_memory", -1) }
+                override fun onConfigurationChanged(configuration: Configuration) = Unit
+            }
+            callbacks = callback
+            app.registerComponentCallbacks(callback)
+            thread = Thread({
+                runCatching { Process.setThreadPriority(Process.THREAD_PRIORITY_BACKGROUND) }
+                for (index in 0 until 1080) {
+                    if (!active.get()) break
+                    runCatching { sample(app, prefix, index % 3 == 0, index == 0) }.onFailure {
+                        runCatching { event(app, prefix, "sample_error_${it.javaClass.simpleName}", -1) }
+                    }
+                    try { Thread.sleep(10000) } catch (_: InterruptedException) { break }
+                }
+            }, "Wachiland-android-memory").apply { isDaemon = true; start() }
+        } catch (error: Exception) {
+            runCatching { File(dir(app), "${session ?: "memory-$origin-${Process.myPid()}"}-begin-error.txt").writeText(error.javaClass.name) }
+            stop(app)
+        }
+    }
+
+    @JvmStatic fun stop(context: Context) {
+        ThermalDiagnostics.stop()
+        active.set(false)
+        thread?.interrupt(); thread = null
+        callbacks?.let { runCatching { context.applicationContext.unregisterComponentCallbacks(it) } }
+        callbacks = null
+    }
+
+    /** Add a ordinary classpath wrapper, avoiding instrument-agent native dependencies. */
+    @JvmStatic fun prepareGameArgs(context: Context, original: Array<String>, java17: Boolean, gameDir: File): Array<String> {
+        val prefix = session ?: return original
+        if (!active.get()) return original
+        return try {
+            val args = original.toMutableList()
+            val main = args.indexOf("mio.Wrapper")
+            val cp = args.indexOfFirst { it == "-cp" || it == "-classpath" || it == "--class-path" }
+            if (main < 0 || cp < 0 || cp + 1 >= main) {
+                event(context, prefix, "jvm_probe_skipped_wrapper_or_classpath_missing", -1)
+                return original
+            }
+            val jar = File(context.filesDir, "wachiland-memory-probe.jar")
+            val staged = File(context.filesDir, "wachiland-memory-probe.tmp")
+            try {
+                context.assets.open("game/wachiland-memory-probe.jar").use { input -> staged.outputStream().use { input.copyTo(it) } }
+                Files.move(staged.toPath(), jar.toPath(), REPLACE_EXISTING)
+            } finally { staged.delete() }
+            args[cp + 1] += ":${jar.absolutePath}"
+            args[main] = "net.wachiland.diagnostics.MemoryMain"
+            val optional = runCatching { PerformanceDiagnostics.prepare(context, prefix, java17, gameDir) }
+                .onFailure { event(context, prefix, "performance_prepare_error_${it.javaClass.simpleName}", -1) }.getOrDefault(emptyList())
+            args.addAll(main, listOf("-Dwachiland.memory.file=${File(dir(context), "$prefix-jvm.csv").absolutePath}", "-Dwachiland.memory.origin=$origin", "-Dwachiland.memory.deep=$deep") + optional)
+            event(context, prefix, "jvm_probe_arguments_prepared", -1)
+            args.toTypedArray()
+        } catch (e: Exception) {
+            runCatching { event(context, prefix, "jvm_probe_unavailable_${e.javaClass.simpleName}", -1) }
+            original
+        }
+    }
+
+    private fun event(context: Context, prefix: String, name: String, level: Int) = append(
+        File(dir(context), "$prefix-events.jsonl"), JSONObject().put("epoch_ms", System.currentTimeMillis())
+            .put("event", name).put("level", level).toString())
+
+    private fun sample(context: Context, prefix: String, fullMemoryInfo: Boolean, mappings: Boolean) {
+        val tick = SystemClock.elapsedRealtime()
+        val manager = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+        val system = ActivityManager.MemoryInfo().also(manager::getMemoryInfo)
+        val runtime = Runtime.getRuntime() // Android ART, NOT game JVM.
+        val row = JSONObject().put("epoch_ms", System.currentTimeMillis()).put("pid", Process.myPid())
+            .put("session_elapsed_ms", System.currentTimeMillis() - origin)
+            .put("android_elapsed_ms", tick)
+            .put("system_total_bytes", system.totalMem).put("system_available_bytes", system.availMem)
+            .put("system_low_threshold_bytes", system.threshold).put("system_low_memory", system.lowMemory)
+            .put("art_heap_used_bytes", runtime.totalMemory() - runtime.freeMemory())
+            .put("art_heap_committed_bytes", runtime.totalMemory()).put("art_heap_max_bytes", runtime.maxMemory())
+            .put("bionic_native_heap_allocated_bytes", Debug.getNativeHeapAllocatedSize())
+            .put("bionic_native_heap_size_bytes", Debug.getNativeHeapSize())
+        row.put("android_meminfo_collected", fullMemoryInfo)
+        if (fullMemoryInfo) runCatching {
+            val info = Debug.MemoryInfo().also(Debug::getMemoryInfo)
+            row.put("android_meminfo_kib", JSONObject(info.memoryStats)).put("process_pss_kib", info.totalPss)
+                .put("process_private_dirty_kib", info.totalPrivateDirty).put("process_private_clean_kib", info.totalPrivateClean)
+        }.onFailure { row.put("android_meminfo_error", it.javaClass.simpleName) }
+        readFields(File("/proc/self/status"), setOf("VmRSS", "VmHWM", "VmSize", "RssAnon", "RssFile", "RssShmem", "VmSwap", "Threads")).forEach { (k,v) -> row.put("proc_$k", v) }
+        readFields(File("/proc/meminfo"), setOf("MemAvailable", "MemFree", "Cached", "SwapTotal", "SwapFree", "Shmem", "Slab", "SReclaimable", "SUnreclaim", "PageTables", "KernelStack")).forEach { (k,v) -> row.put("system_$k", v) }
+        runCatching { row.put("memory_psi", File("/proc/pressure/memory").readText().take(512)) }
+        runCatching { row.put("oom_score_adj", File("/proc/self/oom_score_adj").readText().trim()) }
+        runCatching { row.put("oom_score", File("/proc/self/oom_score").readText().trim()) }
+        row.put("sample_duration_ms", SystemClock.elapsedRealtime() - tick)
+        append(File(dir(context), "$prefix-android.jsonl"), row.toString())
+        runCatching { PerformanceDiagnostics.checkpoint(context, prefix, origin) }.onFailure {
+            event(context, prefix, "performance_checkpoint_error_${it.javaClass.simpleName}", -1)
+        }
+        if (deep) runCatching { attributionCheckpoint(context, prefix, system) }.onFailure {
+            event(context, prefix, "attribution_checkpoint_error_${it.javaClass.simpleName}", -1)
+        }
+        if (mappings) mappingSummary(context, prefix)
+    }
+
+    private fun attributionCheckpoint(context: Context, prefix: String, memory: ActivityManager.MemoryInfo) {
+        val directory = dir(context)
+        val staged = File(directory, "$prefix-headroom.tmp")
+        try {
+            staged.writeText("${System.currentTimeMillis()},${memory.availMem},${memory.lowMemory}")
+            Files.move(staged.toPath(), File(directory, "$prefix-headroom.guard").toPath(), REPLACE_EXISTING)
+        } finally { staged.delete() }
+        if (menuRequested) return
+        val log = FCLPath.getLatestGameLog()
+        if (!log.isFile || log.lastModified() < origin) return
+        val text = RandomAccessFile(log, "r").use { input ->
+            if (input.length() < logCursor) { logCursor = 0; logSessionVerified = false }
+            input.seek((logCursor - 512).coerceAtLeast(0)) // Retain overlap for a split marker line.
+            val bytes = ByteArray(minOf(65536L, input.length() - input.filePointer).toInt())
+            input.readFully(bytes)
+            logCursor = input.filePointer
+            bytes.toString(Charsets.UTF_8)
+        }
+        if (text.contains("-Dwachiland.memory.origin=$origin")) logSessionVerified = true
+        if (!logSessionVerified) return // Reject stale game logs, even if their timestamp changed.
+        val marker = text.lineSequence().firstOrNull { it.contains("ModernFix") &&
+            Regex("Game took [0-9.]+ seconds to start").containsMatchIn(it) } ?: return
+        menuRequested = true
+        File(directory, "$prefix-menu.request").writeText("epoch_ms=${System.currentTimeMillis()}; marker=${marker.take(512)}\n")
+        event(context, prefix, "modernfix_menu_attribution_requested", -1)
+    }
+
+    private fun readFields(file: File, wanted: Set<String>): Map<String, String> = runCatching {
+        val result = linkedMapOf<String, String>()
+        file.useLines { lines -> lines.forEach { line ->
+            val key = line.substringBefore(':'); if (key in wanted) result[key] = line.substringAfter(':').trim()
+        } }; result
+    }.getOrDefault(emptyMap())
+
+    private fun mappingSummary(context: Context, prefix: String) {
+        val tick = SystemClock.elapsedRealtime()
+        val totals = linkedMapOf<String, LongArray>()
+        val names = listOf("Rss", "Pss", "Private_Clean", "Private_Dirty", "Swap", "SwapPss")
+        val header = Regex("^[0-9a-f]+-[0-9a-f]+\\s")
+        var category = "anonymous-unattributed"
+        val result = JSONObject().put("epoch_ms", System.currentTimeMillis())
+        runCatching {
+            File("/proc/self/smaps").useLines { lines -> lines.forEach { line ->
+                if (header.containsMatchIn(line)) {
+                    val path = line.trim().split(Regex("\\s+"), limit = 6).getOrNull(5).orEmpty()
+                    category = when {
+                        path.contains("dalvik", true) || path.contains("art-", true) -> "android-art-mappings"
+                        path.contains("mali", true) || path.contains("kgsl", true) || path.contains("dmabuf", true) || path.contains("gpu", true) -> "gpu-labelled-mappings"
+                        path.contains("stack") -> "stack-labelled-mappings"
+                        path.endsWith(".so") -> "library-file:${File(path).name}"
+                        path.contains("/") -> "other-file-mappings"
+                        path.contains("heap") -> "native-heap-labelled-mappings"
+                        else -> "anonymous-unattributed"
+                    }
+                } else {
+                    val index = names.indexOf(line.substringBefore(':'))
+                    if (index >= 0) {
+                        val value = line.substringAfter(':').trim().substringBefore(' ').toLongOrNull() ?: 0
+                        totals.getOrPut(category) { LongArray(names.size) }[index] += value
+                    }
+                }
+            } }
+            val groups = JSONObject()
+            totals.forEach { (group, values) -> val obj = JSONObject(); names.forEachIndexed { i, key -> obj.put("${key}_kib", values[i]) }; groups.put(group, obj) }
+            result.put("mapping_groups", groups)
+        }.onFailure { result.put("unavailable", it.javaClass.simpleName) }
+        result.put("sample_duration_ms", SystemClock.elapsedRealtime() - tick)
+        append(File(dir(context), "$prefix-mappings.jsonl"), result.toString())
+    }
+
+    private fun append(file: File, text: String) { if (file.length() < 4 * 1024 * 1024) file.appendText("$text\n") }
+}
diff --git a/FCL/src/main/java/net/wachiland/launcher/PerformanceDiagnostics.kt b/FCL/src/main/java/net/wachiland/launcher/PerformanceDiagnostics.kt
